{
  "name": "cfx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "dev:convex": "bun scripts/convex-dev.ts",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsrx-tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "test": "bun test && vitest run",
    "test:convex": "vitest run",
    "icons:build": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts",
    "icons:check": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts --check",
    "fb:claims": "bun run scripts/firebase/seed-claims.ts",
    "fb:check": "bunx @beastjs/auth --check",
    "cf:dev": "bun run build && wrangler dev",
    "cf:check": "bun run build && wrangler deploy --dry-run",
    "cf:deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "^0.33.3",
    "@octanejs/base-ui": "0.1.55",
    "@octanejs/cmdk": "0.1.53",
    "@octanejs/day-picker": "0.0.34",
    "@octanejs/dnd-kit": "0.1.62",
    "@octanejs/motion": "^0.1.54",
    "@octanejs/nuqs": "^0.1.56",
    "@octanejs/select": "0.1.19",
    "@octanejs/tanstack-form": "0.0.64",
    "@octanejs/tanstack-router": "0.3.2",
    "@octanejs/tanstack-table": "^0.1.63",
    "@octanejs/zustand": "^0.1.69",
    "@rsbuild/plugin-node-polyfill": "^1.4.6",
    "beast-tsrx": "0.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.50.0",
    "date-fns": "^4.4.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lenis": "^1.3.27",
    "octane": "0.16.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.17",
    "wrangler": "^4.164.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@beastjs/cli": "0.3.3",
    "@beastjs/devtools": "0.1.23",
    "@beastjs/page-builder": "0.3.0",
    "@edge-runtime/vm": "^5.0.0",
    "@octanejs/rsbuild-plugin": "0.1.69",
    "@rsbuild/core": "^2.2.2",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@tsrx/oxc": "0.20.0",
    "@tsrx/typescript-plugin": "0.6.3",
    "@types/node": "^26.2.0",
    "convex-test": "^0.0.71",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "patchedDependencies": {
    "firebase-admin@14.5.1": "patches/firebase-admin@14.5.1.patch"
  }
}
