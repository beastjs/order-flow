import { useSmoothScroll } from "@/hooks/useSmoothScroll";
import { Link } from "@octanejs/tanstack-router";
import SiteNav from "./SiteNav.btsx";
import AssetIndex from "@/components/app/AssetIndex.btsx";
import { okxChangePct, useOkxPerps, useOkxTickers } from "@/hooks/useOkx";

module
  import type { AssetIndexItem } from "@/components/app/assetFormat"

  const TAPE = [
    "BTC", "ETH", "NVDA", "SOL", "AAPL", "TSLA", "XAU", "HYPE", "MSFT", "DOGE", "META", "AMZN", "CL", "XRP", "GOOGL",
  ].map((base) => `${base}-USDT-SWAP`)

  // Fixed decimals per magnitude, so a symbol's text width never changes tick to tick.
  function tapePrice(last: number | undefined): string {
    if (last === undefined || !Number.isFinite(last)) return "—"
    const d = last >= 1000 ? 1 : last >= 10 ? 2 : 4
    return last.toLocaleString("en-US", { minimumFractionDigits: d, maximumFractionDigits: d })
  }

  const SHOWCASE: AssetIndexItem[] = [
    { instId: "BTC-USDT-SWAP", base: "BTC", category: "crypto", tickSz: 0.1, maxLeverage: 100 },
    { instId: "NVDA-USDT-SWAP", base: "NVDA", category: "stock", tickSz: 0.01, maxLeverage: 20 },
    { instId: "XAU-USDT-SWAP", base: "XAU", category: "commodity", tickSz: 0.01 },
  ]

  const FEATURES = [
    {
      k: "01",
      title: "Footprint, not candles",
      body: "Every bar opened up: bid × ask volume at each price, delta, imbalances and the point of control — as it prints.",
    },
    {
      k: "02",
      title: "Liquidity you can see",
      body: "A resting-book heatmap and depth ladder show where size is waiting, pulled or spoofed before price gets there.",
    },
    {
      k: "03",
      title: "One tape, every venue",
      body: "Binance, Bybit, OKX, Bitget, Hyperliquid and Deribit merged into a single stream, with liquidations, OI and funding.",
    },
  ]

setup
  const scrollRef = useSmoothScroll<HTMLDivElement>();
  const tickers = useOkxTickers(TAPE, 1000);
  const stocks = useOkxPerps("stock").perps.length;
  const crypto = useOkxPerps("crypto").perps.length;

.site(ref={scrollRef})
  SiteNav

  section.lp-hero
    p.lp-eyebrow
      span.lp-live-dot
      | Live crypto, stocks & fx perps
    h1.lp-hero-title
      | Read the tape,
      br
      em not the noise.
    p.lp-hero-sub
      | Venues from OKX and Hyperliquid.
      | Perps from AMZN to ZEC.
      // | A footprint terminal for traders who want to see who is actually buying.
    .lp-hero-cta
      Link.lp-btn.lp-btn-primary(to="/terminal") Open the terminal
      Link.lp-btn.lp-btn-ghost(to="/perps") Browse #{stocks + crypto > 0 ? `${stocks + crypto} ` : ""}markets

  .lp-tape(aria-label="Live prices")
    .lp-tape-track
      each round in [0, 1] key round
        each id in TAPE key `${round}-${id}`
          scope
            setup
              const t = tickers[id];
              const pct = okxChangePct(t, "24h");
            span.lp-tape-item(aria-hidden={round === 1 ? true : undefined})
              b #{id.split("-")[0]}
              span.lp-tape-px #{tapePrice(t?.last)}
              span(className={pct === null ? "lp-tape-pct" : pct >= 0 ? "lp-tape-pct is-up" : "lp-tape-pct is-down"}) #{pct === null ? "—" : `${pct >= 0 ? "+" : ""}${pct.toFixed(2)}%`}

  section.lp-showcase
    each item in SHOWCASE key item.instId
      AssetIndex(item={item})

  section.lp-stats
    .lp-stat
      strong #{crypto || "290"}
      span Crypto perpetuals
    .lp-stat
      strong #{stocks || "230"}
      span US equity perpetuals
    .lp-stat
      strong 6
      span Venues, one tape
    .lp-stat
      strong 0
      span Accounts required

  section.lp-features
    each f in FEATURES key f.k
      article.lp-feature
        span.lp-feature-k #{f.k}
        h3 #{f.title}
        p #{f.body}

  section.lp-closing
    h2
      | The market is talking.
      br
      em Start listening.
    .lp-hero-cta
      Link.lp-btn.lp-btn-primary(to="/terminal") Open the terminal
      Link.lp-btn.lp-btn-ghost(to='/perps') View Markets

  footer.site-foot
    span Market data streamed from public exchange APIs. Not investment advice.
    span © #{new Date().getFullYear()} SuperCEX
