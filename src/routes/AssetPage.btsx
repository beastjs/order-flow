import { useSmoothScroll } from "@/hooks/useSmoothScroll";
import { useEffect, useState } from "octane";
import { Link, useParams, useSearch } from "@octanejs/tanstack-router";
import SiteNav from "./SiteNav.btsx";
import PriceChart from "@/components/app/PriceChart.btsx";
import PositionSimulator from "@/components/app/PositionSimulator.btsx";
import { RANGE_LABELS, useHlAssetView, useOkxAssetView, type RangeKey } from "@/hooks/useAssetView";
import { toHlCoin } from "@/lib/hyperliquid";
import { CATEGORY_LABEL, VENUE_LABEL, fmtCompact, fmtPct, fmtPrice, fmtSize, glyphSrc, instIdFromAssetId, terminalHref, venueSearch, type MarketVenue } from "@/components/app/assetFormat";
import { cn } from "@/lib/utils";
import Middot from "../components/ui/Middot.btsx";

module
  function countdown(to: number | undefined, now: number): string {
    if (!to || !now) return "—"
    const s = Math.max(0, Math.floor((to - now) / 1000))
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), r = s % 60
    return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}:${String(r).padStart(2, "0")}`
  }

component Glyph
  props { base, coin, venue='okx' }: { base: string; coin: string; venue: MarketVenue }
  setup const [failed, setFailed] = useState(false);
  span.asset-glyph.asset-glyph-lg(className='portrait:size-11!')
    if failed
      span.asset-glyph-mono #{coin.slice(0, 3)}
    else
    img(src={glyphSrc(coin, venue)} alt={base} onError={() => void setFailed(true)})

component Stat
  props { label, value, tone }: { label: string; value: string; tone?: "up" | "down" }
  .ap-stat
    span #{label}
    strong(className={tone === "up" ? "is-up" : tone === "down" ? "is-down" : undefined}) #{value}

setup
  const scrollRef = useSmoothScroll<HTMLDivElement>();
  const { assetId } = useParams({ strict: false }) as { assetId: string };
  const search = useSearch({ strict: false }) as { venue?: "hyperliquid" };
  const venue: MarketVenue = search.venue === "hyperliquid" ? "hyperliquid" : "okx";
  const isHl = venue === "hyperliquid";
  const [range, setRange] = useState<RangeKey>("1d");
  const [now, setNow] = useState(0);

  useEffect(() => {
    const id = setInterval(() => setNow(Date.now()), 1000);
    setNow(Date.now());
    return () => clearInterval(id);
  }, []);

  // Both hooks run every render; only the active venue gets an id and subscribes.
  const okxView = useOkxAssetView(isHl ? null : instIdFromAssetId(assetId), range);
  const hlView = useHlAssetView(isHl ? toHlCoin(assetId) : null, range);
  const v = isHl ? hlView : okxView;
  const inst = v.meta;
  const coin = isHl ? toHlCoin(assetId) : assetId;
  const title = inst?.base ?? coin;
  // OKX only lists crypto and equity perps worth linking to.
  const okxTwin = inst && isHl && (inst.category === "crypto" || inst.category === "stock") ? inst.base : null;

  const tick = inst?.tickSz;
  const up = (v.change ?? 0) >= 0;
  const basis = v.markPx && v.indexPx ? ((v.markPx - v.indexPx) / v.indexPx) * 100 : null;
  const book = v.book;
  const maxBook = book ? Math.max(1e-9, ...book.bids.map((l) => l.size), ...book.asks.map((l) => l.size)) : 1;
  const spread = book && book.bids[0] && book.asks[0] ? book.asks[0].price - book.bids[0].price : null;
  // Hyperliquid's ctx mid lags the book; center the book on its own touch.
  const bookMid = isHl && book && book.bids[0] && book.asks[0] ? (book.bids[0].price + book.asks[0].price) / 2 : v.last;
  const terminal = inst ? terminalHref(inst, venue) : null;

.site( ref={scrollRef})
  SiteNav
  if inst === null || inst === undefined
    section.lp-page-head(className='portrait:w-screen!')
      p.lp-eyebrow
        Link(to="/perps" search={venueSearch(venue)}) ← All markets
      h1.lp-page-title #{title}
      p.lp-page-sub #{VENUE_LABEL[venue]} doesn’t list a live #{isHl ? "" : "USDT "}perpetual for “#{assetId}”.
  else
    .ap-body
      section.ap-head(className='portrait:-mt-6!')
        div(className='flex items-center justify-between')
          Link.ap-back(to="/perps" search={venueSearch(venue)}) ← All markets
          div(className='')
            if inst
              span(className='font-mono text-sm uppercase!') #{`${VENUE_LABEL[venue]}`}
        .ap-title
          Glyph(base={title} coin={coin} venue={venue})
          div(className='flex items-center justify-between w-full')
            div(className='')
              div(className='flex items-center gap-4')
                h1 #{title}
                span.asset-index-tag #{`${inst?.maxLeverage}x`}
              if inst
                div(className='flex items-center! gap-3 sm:gap-4 md:gap-5 text-(--text-muted)!')
                  if !inst?.preMarket
                    p.asset-index-tag Pre-IPO
                  else
                    span #{`${CATEGORY_LABEL[inst.category]}`}
                  Middot
                  p Info
              else
                p Loading...

          .ap-price(className=' portrait:min-w-32 flex flex-col items-end! portrait:-space-y-1')
            span.ap-last(className='portrait:text-3xl! text-(--text-primary)!') #{fmtPrice(v.last, tick)}
            span.ap-change(className={cn('portrait:text-sm! portrait:tracking-tightest', up ? "is-up" : "is-down")}) #{fmtPct(v.change)} · 24h

      .ap-main
        section.ap-chart-card
          .ap-ranges(role="tablist")
            each x in RANGE_LABELS key x.key
              button(type="button" role="tab" aria-selected={range === x.key} className={cn("lp-seg", range === x.key && "is-active")} onClick={() => setRange(x.key)})
                if x.key === "live"
                  span.lp-live-dot
                | #{x.label}
          PriceChart(candles={v.candles} tickSz={tick} loading={v.candlesLoading})
        if inst && !isHl
          PositionSimulator(instId={inst.instId} base={inst.base} tickSz={tick} maxLeverage={inst.maxLeverage} ticker={v.okxTicker} markPx={v.markPx})
        elseif inst
          aside.ap-panel.ap-venue-note
            h2 Trade #{inst.base}
            p.ap-muted Paper and live positions fill against OKX quotes. Hyperliquid data here is view-only.
            if okxTwin
              Link.lp-btn(to="/perps/$assetId" params={{ assetId: okxTwin }} search={{}}) Open #{okxTwin} on OKX →

      section.ap-stats
        Stat(label="Mark price" value={fmtPrice(v.markPx, tick)})
        Stat(label={v.indexLabel} value={fmtPrice(v.indexPx, tick)})
        Stat(label="Basis" value={fmtPct(basis, 3)} tone={basis === null ? undefined : basis >= 0 ? "up" : "down"})
        Stat(label={`Funding ${v.fundingHours}h / next`} value={`${fmtPct(v.fundingPct, 4)} · ${countdown(v.nextFunding, now)}`} tone={v.fundingPct === null ? undefined : v.fundingPct >= 0 ? "up" : "down"})
        Stat(label="Open interest" value={v.oiUsd ? `$${fmtCompact(v.oiUsd)}` : "—"})
        Stat(label="24h volume" value={v.volUsd ? `$${fmtCompact(v.volUsd)}` : "—"})
        Stat(label="24h high" value={fmtPrice(v.high24h, tick)})
        Stat(label="24h low" value={fmtPrice(v.low24h, tick)})

      section.ap-grid
        article.ap-panel
          header.ap-panel-head
            h2 Order book
            span #{spread === null ? "" : `Spread ${fmtPrice(spread, tick)}`}
          .ap-book
            .ap-book-side.is-asks
              each l in (book?.asks ?? []).slice(0, 10).reverse() key `a${l.price}`
                .ap-book-row(style={{ "--depth": `${(l.size / maxBook) * 100}%` }})
                  span.is-down #{fmtPrice(l.price, tick)}
                  span #{fmtSize(l.size)}
            .ap-book-mid #{fmtPrice(bookMid, tick)}
            .ap-book-side.is-bids
              each l in (book?.bids ?? []).slice(0, 10) key `b${l.price}`
                .ap-book-row(style={{ "--depth": `${(l.size / maxBook) * 100}%` }})
                  span.is-up #{fmtPrice(l.price, tick)}
                  span #{fmtSize(l.size)}
        article.ap-panel
          header.ap-panel-head
            h2 Trades
            span #{isHl ? "Every fill · Hyperliquid WS" : "Every fill · business WS"}
          .ap-trades
            each t in v.trades key t.id
              .ap-trade-row
                span(className={t.side === "buy" ? "is-up" : "is-down"}) #{fmtPrice(t.price, tick)}
                span #{fmtSize(t.size)}
                span.ap-trade-time #{new Date(t.ts).toLocaleTimeString("en-US", { hour12: false })}
            empty
              p.ap-muted Waiting for prints…

      if terminal
        section.ap-cta
          a.lp-btn.lp-btn-primary(href={terminal}) Open #{inst?.base} in the footprint terminal →

  footer.site-foot
    span #{isHl ? "Data: Hyperliquid public WebSocket (api.hyperliquid.xyz)." : "Data: OKX public & business WebSocket."} Sizes shown in #{inst?.category === "stock" ? "shares" : "base units"}. Not investment advice.
