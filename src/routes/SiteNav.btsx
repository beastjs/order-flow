import { Link } from "@octanejs/tanstack-router";
import { Wordmark } from "@/components/Logo.btsx";
import WalletButton from "@/components/WalletButton.btsx";
import SignButton from "@/components/SignButton.btsx";
header.site-nav
  Link.site-brand(to="/")
    Wordmark(size={24})
  nav.site-links
    Link(to="/predictions" activeProps={{ className: "is-active" }}) Markets
    Link(to="/terminal" activeProps={{ className: "is-active" }}) Terminal
    .site-wallet
      WalletButton
      SignButton
