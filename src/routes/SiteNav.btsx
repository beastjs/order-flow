import { Link, useLocation } from "@octanejs/tanstack-router";
import { Wordmark } from "@/components/terminal/Logo.btsx";
import WalletButton from "@/components/head/WalletButton.btsx";
import SignButton from "@/components//head/SignButton.btsx";
import BalancePill from "@/components/head/BalancePill.btsx";
import MobileMenu from "@/components/terminal/MobileMenu.btsx";
import { useOpenPositions } from "@/hooks/usePaperAccount";
import { usePersonalPositions } from "@/hooks/useLiveAccount";
import { useFirebaseUser } from "@/lib/firebase/auth";
import { cn } from "@/lib/utils";

setup
  // Markets and Positions share /perps (Positions is ?tab=positions), so
  // the router's own active matching can't tell them apart — decide here.
  const location = useLocation();
  const onPositions = location.pathname === "/perps" && (location.search as { tab?: string }).tab === "positions";
  const onMarkets = location.pathname.startsWith("/perps") && !onPositions;
  const onTerminal = location.pathname.startsWith("/terminal");
  const openCount = useOpenPositions().rows.length + usePersonalPositions().rows.length;
  const { user } = useFirebaseUser();

header.site-nav
  Link.site-brand(to="/" aria-label="Home")
    Wordmark(size={24})
  nav.site-links
    Link(to="/perps" search={{}} className={cn(onMarkets && "is-active")} aria-current={onMarkets ? "page" : undefined}) Markets
    Link(to="/terminal" className={cn(onTerminal && "is-active")} aria-current={onTerminal ? "page" : undefined}) Terminal
    Link(to="/perps" search={{ tab: "positions" }} className={cn('min-w-[32px]', onPositions && "is-active")} aria-current={onPositions ? "page" : undefined})
      | Positions
      span.site-link-badge(aria-label={`${openCount} open`}) #{openCount ?? 0}
  .site-wallet
    div(className='min-w-[160px]')
      if user
        BalancePill
    WalletButton
    SignButton
  // Phones: everything above collapses into this one menu (hidden on wider screens).
  MobileMenu
