import { useSmoothScroll } from "@/hooks/useSmoothScroll";
import { createElement, useEffect, useMemo, useRef, useState } from "octane";
import { Link, useSearch } from "@octanejs/tanstack-router";
import { debounce, useQueryStates } from "@octanejs/nuqs";
import { perpsParams, type PerpsFilter, type PerpsSort } from "@/lib/url/perpsParams";
import SiteNav from "./SiteNav.btsx";
import OpenPositions from "@/components/app/OpenPositions.btsx";
import TradeHistory from "@/components/app/TradeHistory.btsx";
import type { PerpsTab } from "@/router";
import { useOpenPositions } from "@/hooks/usePaperAccount";
import AssetIndex from "@/components/app/AssetIndex.btsx";
import { useOkxTickerSnapshot } from "@/hooks/useOkx";
import { useHlPerps } from "@/hooks/useHyperliquid";
import { fetchPerps, type OkxPerpInstrument } from "@/lib/okx";
import { hlTickSz, type HlAssetCtx } from "@/lib/hyperliquid";
import { VENUE_LABEL, venueSearch, type MarketVenue } from "@/components/app/assetFormat";
import { cn } from "@/lib/utils";
import Menu, { MenuSection } from "@/components/ui/Menu.btsx";
import {Icon} from "@/lib/icons";

module
  import type { AssetIndexItem } from "@/components/app/assetFormat"
  import type { OkxTicker } from "@/lib/okx"

  type Filter = PerpsFilter
  type Sort = PerpsSort

  const FILTERS: { value: Filter; label: string }[] = [
    { value: "all", label: "All" },
    { value: "crypto", label: "Crypto" },
    { value: "stock", label: "Equities" },
    { value: "commodity", label: "Commodities" },
    { value: "fx", label: "FX" },
    { value: "index", label: "Indices" },
    { value: "other", label: "Other" },
  ]

  const SORTS: { value: Sort; label: string }[] = [
    { value: "volume", label: "Volume" },
    { value: "gainers", label: "Gainers" },
    { value: "losers", label: "Losers" },
    { value: "name", label: "A–Z" },
  ]

  const VENUES: MarketVenue[] = ["okx", "hyperliquid"]

  /** One market row, whichever venue lists it. */
  interface Market {
    item: AssetIndexItem
    initial?: OkxTicker | HlAssetCtx
    turnover: number
    change: number
  }

  function toItem(p: OkxPerpInstrument): AssetIndexItem {
    return {
      venue: "okx",
      instId: p.instId,
      base: p.base,
      category: p.category,
      tickSz: p.tickSz,
      maxLeverage: p.maxLeverage,
      preMarket: p.ruleType === "pre_market",
    }
  }

setup
  const scrollRef = useSmoothScroll<HTMLDivElement>();
  const search = useSearch({ strict: false }) as { tab?: PerpsTab };
  const tab = search.tab ?? "markets";
  // Toolbar state lives in the URL: ?venue=&cat=&sort=&q= (defaults omitted).
  const [params, setParams] = useQueryStates(perpsParams);
  const venue: MarketVenue = params.venue;
  const sort = params.sort;
  const query = params.q;
  const isHl = venue === "hyperliquid";
  const hlPerps = useHlPerps(isHl);
  const openCount = useOpenPositions().rows.length;
  const [perps, setPerps] = useState<OkxPerpInstrument[]>([]);
  const [error, setError] = useState<string | null>(null);
  // A new venue is a new page of results: push it. Category, sort and search carry over.
  const chooseVenue = (v: MarketVenue) => void setParams({ venue: v }, { history: "push" });
  const chooseFilter = (f: Filter) => void setParams({ cat: f }, { history: "replace" });
  const chooseSort = (s: Sort) => void setParams({ sort: s }, { history: "replace" });
  // Typing updates the input at once; the URL catches up 300ms after the last key.
  // "/" focuses the search from anywhere on the page (unless you're already typing somewhere).
  const searchRef = useRef<HTMLInputElement | null>(null);
  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey || e.defaultPrevented) return;
      const el = e.target as HTMLElement | null;
      if (el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
      const input = searchRef.current;
      if (!input) return;
      e.preventDefault();
      input.focus();
      input.select();
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, []);
  const typeQuery = (q: string) =>
    void setParams({ q }, { history: "replace", limitUrlUpdates: q ? debounce(300) : undefined });
  const snapshot = useOkxTickerSnapshot();

  useEffect(() => {
    let alive = true;
    fetchPerps()
      .then((all) => alive && setPerps(all.filter((p) => p.settleCcy === "USDT" && p.state === "live")))
      .catch((e) => alive && setError(e instanceof Error ? e.message : String(e)));
    return () => { alive = false };
  }, []);

  const markets = useMemo<Market[]>(() => {
    if (isHl) {
      return hlPerps.perps.map(({ meta, ctx }) => ({
        item: { venue: "hyperliquid", instId: meta.name, base: meta.base, dex: meta.dex || undefined, category: meta.category, tickSz: hlTickSz(meta.szDecimals, ctx.markPx), maxLeverage: meta.maxLeverage },
        initial: ctx,
        turnover: ctx.dayNtlVlm,
        change: ctx.prevDayPx > 0 ? (ctx.midPx ?? ctx.markPx) / ctx.prevDayPx - 1 : 0,
      }));
    }
    return perps.map((p) => {
      const t = snapshot[p.instId];
      return {
        item: toItem(p),
        initial: t,
        turnover: t ? t.volCcy24h * t.last : 0,
        change: t && t.open24h > 0 ? t.last / t.open24h - 1 : 0,
      };
    });
  }, [isHl, hlPerps.perps, perps, snapshot]);
  const loadError = isHl ? hlPerps.error : error;

  const counts = useMemo(() => {
    const c: Record<Filter, number> = { all: markets.length, crypto: 0, stock: 0, commodity: 0, fx: 0, index: 0, other: 0 };
    for (const m of markets) c[m.item.category]++;
    return c;
  }, [markets]);
  // A linked category this venue doesn't list (e.g. ?cat=fx on OKX) falls back to All once loaded.
  const filter: Filter = params.cat === "all" || !markets.length || counts[params.cat] > 0 ? params.cat : "all";

  const visible = useMemo(() => {
    const q = query.trim().toUpperCase();
    const list = markets.filter((m) => (filter === "all" || m.item.category === filter) && (!q || m.item.base.toUpperCase().includes(q)));
    const by: Record<Sort, (a: Market, b: Market) => number> = {
      volume: (a, b) => b.turnover - a.turnover,
      gainers: (a, b) => b.change - a.change,
      losers: (a, b) => a.change - b.change,
      name: (a, b) => a.item.base.localeCompare(b.item.base),
    };
    return list.sort(by[sort]);
  }, [markets, filter, sort, query]);

  // Only offer the asset classes this venue actually lists.
  const filters = FILTERS.filter((f) => f.value === "all" || counts[f.value] > 0);

.site(className={cn('portrait:px-[clamp(0px,0vw,0px)]!', tab === "history" && "site-trade-history")} ref={scrollRef})
  SiteNav
  section.lp-page-head
    if tab !== "history"
      p.lp-eyebrow
        span.lp-live-dot
        | Streaming Live from #{VENUE_LABEL[venue]}
    if tab === "history"
      h1.lp-page-title Trade history
    elseif tab === "positions"
      h1.lp-page-title
        | #{"Your positions,  "}
        em live.
    else
      h1.lp-page-title
        | #{"Every perpetual, "}
        em live.
    if tab !== "history"
      p.lp-page-sub(className='portrait:hidden!') #{tab === "positions" ? "Your positions marked to the live OKX mark price. Close any of them at market." : !counts.all ? `Loading the ${VENUE_LABEL[venue]} instrument catalog…` : isHl ? `${counts.crypto} crypto, ${counts.stock} equity, ${counts.commodity} commodity, ${counts.fx} FX and ${counts.index} index perpetuals across Hyperliquid and its builder dexes. Prices stream only for the cards on screen.` : `${counts.crypto} crypto, ${counts.stock} equity and ${counts.commodity} commodity perpetuals. Prices stream only for the cards on screen.`}

  nav.lp-tabs(className={tab === "history" ? "trade-history-tabs" : 'sm:mx-12! sm:px-2!'} aria-label="Perpetuals")
    Link(to="/perps" search={venueSearch(venue)} className={cn("lp-tab", tab === "markets" && "is-active")} aria-current={tab === "markets" ? "page" : undefined})
      | Markets
      span.lp-seg-count #{counts.all || ""}
    Link(to="/perps" search={{ tab: "positions", ...venueSearch(venue) }} className={cn("lp-tab", tab === "positions" && "is-active")} aria-current={tab === "positions" ? "page" : undefined})
      | Positions
      span.lp-seg-count #{openCount || ""}
    Link(to="/perps" search={{ tab: "history", ...venueSearch(venue) }} className={cn("lp-tab", tab === "history" && "is-active")} aria-current={tab === "history" ? "page" : undefined}) Trade history

  if tab === "positions"
    OpenPositions
  elseif tab === "history"
    TradeHistory
  else
    section(className='portrait:px-0!')
      .lp-toolbar
        div(className='flex items-center justify-between w-full')
          input.lp-search(
            ~ className='portrait:px-6! portrait:w-full!'
            ~ ref={searchRef}
            ~ type="search"
            ~ placeholder="Search markets"
            ~ title="Search markets (/)"
            ~ aria-keyshortcuts="/"
            ~ value={query}
            ~ onInput={(e: Event) => typeQuery((e.target as HTMLInputElement).value)}
            ~ onKeyDown={(e: KeyboardEvent) => { if (e.key === "Escape") (e.target as HTMLInputElement).blur() }}
            ~ )
          // Mobile: the toolbar's right side is hidden, so its venue / category / sort live in this popover.
          div(className='flex shrink-0 sm:hidden portrait:flex portrait:items-center! border-b! border-(--border)! size-13.5')
            Menu(
              ~ hint="Filters"
              ~ buttonClassName='size-13.5 rounded-none! bg-transparent! text-(--text-secondary) border-0 aria-expanded:text-(--text-primary)'
              ~ label={createElement(Icon, { name: "menu" })}
              ~ )
              MenuSection(title="Source")
                each v in VENUES key v
                  button.menu-item.menu-action.menu-choice(type="button" role="menuitemradio" aria-checked={venue === v} onClick={() => chooseVenue(v)})
                    span.menu-item-text
                      span #{VENUE_LABEL[v]}
              MenuSection(title="Category")
                each f in filters key f.value
                  button.menu-item.menu-action.menu-choice(type="button" role="menuitemradio" aria-checked={filter === f.value} onClick={() => chooseFilter(f.value)})
                    span.menu-item-text
                      span #{f.label}
                      small #{counts[f.value] || ""}
              MenuSection(title="Sort")
                each s in SORTS key s.value
                  button.menu-item.menu-action.menu-choice(type="button" role="menuitemradio" aria-checked={sort === s.value} onClick={() => chooseSort(s.value)})
                    span.menu-item-text
                      span #{s.label}

        .lp-toolbar-right(className='portrait:hidden!')
          .lp-segmented(aria-label="Data source")
            each v in VENUES key v
              button(type="button" className={cn("lp-seg", venue === v && "is-active")} aria-pressed={venue === v} onClick={() => chooseVenue(v)}) #{VENUE_LABEL[v]}
          .lp-segmented(role="tablist")
            each f in filters key f.value
              button(
                ~ type="button"
                ~ role="tab"
                ~ aria-selected={filter === f.value}
                ~ className={cn("lp-seg", filter === f.value && "is-active")}
                ~ onClick={() => chooseFilter(f.value)}
                ~ )
                | #{f.label}
                span.lp-seg-count #{counts[f.value] || ""}
          .lp-segmented
            each s in SORTS key s.value
              button(type="button" className={cn("lp-seg", sort === s.value && "is-active")} onClick={() => chooseSort(s.value)}) #{s.label}

      if loadError
        p.lp-grid-empty Couldn’t load #{VENUE_LABEL[venue]} instruments: #{loadError}
      else
        section.lp-asset-grid(className='portrait:px-4! portrait:mx-auto!')
          each m in visible key `${venue}:${m.item.instId}`
            AssetIndex(item={m.item} initial={m.initial})
          empty
            p.lp-grid-empty #{markets.length ? "No markets match your search." : "Loading markets…"}

  footer.site-foot
    span #{VENUE_LABEL[venue]} public market data. Perpetual swaps are leveraged derivatives. Not investment advice.
