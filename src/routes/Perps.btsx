import { useSmoothScroll } from "@/hooks/useSmoothScroll";
import { useEffect, useMemo, useState } from "octane";
import { Link, useSearch } from "@octanejs/tanstack-router";
import SiteNav from "./SiteNav.btsx";
import OpenPositions from "@/components/app/OpenPositions.btsx";
import { useOpenPositions } from "@/hooks/usePaperAccount";
import AssetIndex from "@/components/app/AssetIndex.btsx";
import { useOkxTickerSnapshot } from "@/hooks/useOkx";
import { useHlPerps } from "@/hooks/useHyperliquid";
import { fetchPerps, type OkxPerpInstrument } from "@/lib/okx";
import { hlTickSz, type HlAssetCtx } from "@/lib/hyperliquid";
import { VENUE_LABEL, venueSearch, type MarketVenue } from "@/components/app/assetFormat";
import { cn } from "@/lib/utils";

module
  import type { AssetCategory, AssetIndexItem } from "@/components/app/assetFormat"
  import type { OkxTicker } from "@/lib/okx"

  type Filter = "all" | AssetCategory
  type Sort = "volume" | "gainers" | "losers" | "name"

  const FILTERS: { value: Filter; label: string }[] = [
    { value: "all", label: "All" },
    { value: "crypto", label: "Crypto" },
    { value: "stock", label: "Equities" },
    { value: "commodity", label: "Commodities" },
    { value: "fx", label: "FX" },
    { value: "index", label: "Indices" },
    { value: "other", label: "Other" },
  ]

  const SORTS: { value: Sort; label: string }[] = [
    { value: "volume", label: "Volume" },
    { value: "gainers", label: "Gainers" },
    { value: "losers", label: "Losers" },
    { value: "name", label: "A–Z" },
  ]

  const VENUES: MarketVenue[] = ["okx", "hyperliquid"]

  /** One market row, whichever venue lists it. */
  interface Market {
    item: AssetIndexItem
    initial?: OkxTicker | HlAssetCtx
    turnover: number
    change: number
  }

  function toItem(p: OkxPerpInstrument): AssetIndexItem {
    return {
      venue: "okx",
      instId: p.instId,
      base: p.base,
      category: p.category,
      tickSz: p.tickSz,
      maxLeverage: p.maxLeverage,
      preMarket: p.ruleType === "pre_market",
    }
  }

setup
  const scrollRef = useSmoothScroll<HTMLDivElement>();
  const search = useSearch({ strict: false }) as { tab?: "positions"; venue?: "hyperliquid" };
  const tab = search.tab === "positions" ? "positions" : "markets";
  const venue: MarketVenue = search.venue === "hyperliquid" ? "hyperliquid" : "okx";
  const isHl = venue === "hyperliquid";
  const hlPerps = useHlPerps();
  const openCount = useOpenPositions().rows.length;
  const [perps, setPerps] = useState<OkxPerpInstrument[]>([]);
  const [error, setError] = useState<string | null>(null);
  const [filter, setFilter] = useState<Filter>("all");
  const [sort, setSort] = useState<Sort>("volume");
  const [query, setQuery] = useState("");
  const snapshot = useOkxTickerSnapshot();

  useEffect(() => {
    let alive = true;
    fetchPerps()
      .then((all) => alive && setPerps(all.filter((p) => p.settleCcy === "USDT" && p.state === "live")))
      .catch((e) => alive && setError(e instanceof Error ? e.message : String(e)));
    return () => { alive = false };
  }, []);

  const markets = useMemo<Market[]>(() => {
    if (isHl) {
      return hlPerps.perps.map(({ meta, ctx }) => ({
        item: { venue: "hyperliquid", instId: meta.name, base: meta.base, dex: meta.dex || undefined, category: meta.category, tickSz: hlTickSz(meta.szDecimals, ctx.markPx), maxLeverage: meta.maxLeverage },
        initial: ctx,
        turnover: ctx.dayNtlVlm,
        change: ctx.prevDayPx > 0 ? (ctx.midPx ?? ctx.markPx) / ctx.prevDayPx - 1 : 0,
      }));
    }
    return perps.map((p) => {
      const t = snapshot[p.instId];
      return {
        item: toItem(p),
        initial: t,
        turnover: t ? t.volCcy24h * t.last : 0,
        change: t && t.open24h > 0 ? t.last / t.open24h - 1 : 0,
      };
    });
  }, [isHl, hlPerps.perps, perps, snapshot]);
  const loadError = isHl ? hlPerps.error : error;

  const counts = useMemo(() => {
    const c: Record<Filter, number> = { all: markets.length, crypto: 0, stock: 0, commodity: 0, fx: 0, index: 0, other: 0 };
    for (const m of markets) c[m.item.category]++;
    return c;
  }, [markets]);

  const visible = useMemo(() => {
    const q = query.trim().toUpperCase();
    const list = markets.filter((m) => (filter === "all" || m.item.category === filter) && (!q || m.item.base.toUpperCase().includes(q)));
    const by: Record<Sort, (a: Market, b: Market) => number> = {
      volume: (a, b) => b.turnover - a.turnover,
      gainers: (a, b) => b.change - a.change,
      losers: (a, b) => a.change - b.change,
      name: (a, b) => a.item.base.localeCompare(b.item.base),
    };
    return list.sort(by[sort]);
  }, [markets, filter, sort, query]);

  // Only offer the asset classes this venue actually lists.
  const filters = FILTERS.filter((f) => f.value === "all" || counts[f.value] > 0);
  useEffect(() => { setFilter("all") }, [venue]);

.site(ref={scrollRef})
  SiteNav
  section.lp-page-head
    p.lp-eyebrow
      span.lp-live-dot
      | Streaming Live from #{VENUE_LABEL[venue]}
    if tab === "positions"
      h1.lp-page-title
        | #{"Your positions, "}
        em live.
    else
      h1.lp-page-title
        | #{"Every perpetual, "}
        em live.
    p.lp-page-sub #{tab === "positions" ? "Open positions marked to the live OKX mark price. Close any of them at market." : !counts.all ? `Loading the ${VENUE_LABEL[venue]} instrument catalog…` : isHl ? `${counts.crypto} crypto, ${counts.stock} equity, ${counts.commodity} commodity, ${counts.fx} FX and ${counts.index} index perpetuals across Hyperliquid and its builder dexes. Prices stream only for the cards on screen.` : `${counts.crypto} crypto, ${counts.stock} equity and ${counts.commodity} commodity perpetuals. Prices stream only for the cards on screen.`}

  nav.lp-tabs(aria-label="Perpetuals")
    Link(to="/perps" search={venueSearch(venue)} className={cn("lp-tab", tab === "markets" && "is-active")} aria-current={tab === "markets" ? "page" : undefined})
      | Markets
      span.lp-seg-count #{counts.all || ""}
    Link(to="/perps" search={{ tab: "positions", ...venueSearch(venue) }} className={cn("lp-tab", tab === "positions" && "is-active")} aria-current={tab === "positions" ? "page" : undefined})
      | Positions
      span.lp-seg-count #{openCount || ""}

  if tab === "positions"
    OpenPositions
  else
    .lp-markets
      .lp-toolbar
        input.lp-search(
          ~ type="search"
          ~ placeholder="Search markets"
          ~ value={query}
          ~ onInput={(e: Event) => setQuery((e.target as HTMLInputElement).value)}
          ~ )
        .lp-toolbar-right
          .lp-segmented(aria-label="Data source")
            each v in VENUES key v
              Link(to="/perps" search={venueSearch(v)} className={cn("lp-seg", venue === v && "is-active")} aria-current={venue === v ? "page" : undefined}) #{VENUE_LABEL[v]}
          .lp-segmented(role="tablist")
            each f in filters key f.value
              button(
                ~ type="button"
                ~ role="tab"
                ~ aria-selected={filter === f.value}
                ~ className={cn("lp-seg", filter === f.value && "is-active")}
                ~ onClick={() => setFilter(f.value)}
                ~ )
                | #{f.label}
                span.lp-seg-count #{counts[f.value] || ""}
          .lp-segmented
            each s in SORTS key s.value
              button(type="button" className={cn("lp-seg", sort === s.value && "is-active")} onClick={() => setSort(s.value)}) #{s.label}

      if loadError
        p.lp-grid-empty Couldn’t load #{VENUE_LABEL[venue]} instruments: #{loadError}
      else
        section.lp-asset-grid
          each m in visible key `${venue}:${m.item.instId}`
            AssetIndex(item={m.item} initial={m.initial})
          empty
            p.lp-grid-empty #{markets.length ? "No markets match your search." : "Loading markets…"}

  footer.site-foot
    span #{VENUE_LABEL[venue]} public market data. Perpetual swaps are leveraged derivatives. Not investment advice.
