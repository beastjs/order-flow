
module "use client";
import { useMarketData } from "@/hooks/useMarketData";
import { useAlerts } from "@/hooks/useAlerts";
import AlertToasts from "@/components/AlertToasts.btsx";
import ReplayBar from "@/components/ReplayBar.btsx";
import SessionContextProvider from "@/lib/session/SessionContextProvider.btsx";
import { useSessionStore } from "@/lib/session/sessionContext";
import { useUIStore } from "@/lib/store/uiStore";
import { applyTheme } from "@/lib/theme";
import MarketStatsBar from "@/components/MarketStatsBar.btsx";
import FootprintChart from "@/components/FootprintChart.btsx";
import OrderBookPanel from "@/components/OrderBook.btsx";
import OBIPanel from "@/components/OBIPanel.btsx";
import TimeAndSales from "@/components/TimeAndSales.btsx";
import DepthOfMarket from "@/components/DepthOfMarket.btsx";
import CVDPanel from "@/components/CVDPanel.btsx";
import VolumeZScorePanel from "@/components/VolumeZScorePanel.btsx";
import VolatilityPanel from "@/components/VolatilityPanel.btsx";
import LiquidationsPanel from "@/components/LiquidationsPanel.btsx";
import OpenInterestPanel from "@/components/OpenInterestPanel.btsx";
import VenuesPanel from "@/components/VenuesPanel.btsx";
import GlobalTooltip from "@/components/GlobalTooltip.btsx";
import HoverHint from "@/components/HoverHint.btsx";
import StatusBar from "@/components/StatusBar.btsx";
import BugReportDialog from "@/components/BugReportDialog.btsx";
import type { PanelVisibility } from "@/lib/types/market";
import { useEffect, useLayoutEffect, useState, useRef } from "octane";
import type { ComponentType } from "octane";
import Topbar from "./Topbar.btsx";

module

  // ─── Terminal shell ──────────────────────────────────────
  //  ┌ top bar ─────────────────────────────────────────────┐
  //  ├ KPI strip ───────────────────────────────────────────┤
  //  │ footprint + session profile        │ order book      │
  //  │                                    │ book imbalance  │
  //  ├ studies: CVD · Vol Z · OI · Liq · ─┤ time & sales    │
  //  │          RV · Depth                │                 │
  //  └ status bar ──────────────────────────────────────────┘

  const STUDIES: {
    key: keyof PanelVisibility;
    Component: ComponentType;
    perpOnly?: boolean;
  }[] = [
    { key: "cvd", Component: CVDPanel },
    { key: "volumeZ", Component: VolumeZScorePanel },
    { key: "openInterest", Component: OpenInterestPanel, perpOnly: true },
    { key: "liquidations", Component: LiquidationsPanel, perpOnly: true },
    { key: "venues", Component: VenuesPanel },
    { key: "volatility", Component: VolatilityPanel },
    { key: "depthOfMarket", Component: DepthOfMarket },
  ];
  function clamp(value: number, min: number, max: number) {
    return Math.min(max, Math.max(min, value));
  }
component SessionTerminal
  setup
    useMarketData();
    useAlerts();
    const panels = useUIStore((s) => s.panels);
    const theme = useUIStore((s) => s.theme);
    const [sidebarWidth, setSidebarWidth] = useState(320);
    const [dockHeight, setDockHeight] = useState(236);
    const [obiHeight, setObiHeight] = useState(160);
    const [bookShare, setBookShare] = useState(0.56);
    const sidebarRef = useRef<HTMLElement | null>(null);

    useLayoutEffect(() => {
      applyTheme(theme);
    }, [theme]);

    // The value-area % is a UI preference but the profile is computed in the session.
    const valueAreaPct = useUIStore((s) => s.indicators.valueAreaPct);

    const setValueAreaPct = useSessionStore((s) => s.setValueAreaPct);
    useEffect(() => setValueAreaPct(valueAreaPct), [valueAreaPct, setValueAreaPct]);
    const marketType = useSessionStore((s) => s.marketType);
    const studies = STUDIES.filter((study) => panels[study.key] && (!study.perpOnly || marketType === "perpetual"));
    const showSidebar = panels.orderBook || panels.obi || panels.timeSales;
  .terminal
    GlobalTooltip
    HoverHint
    BugReportDialog
    Topbar
    ReplayBar
    MarketStatsBar
    .workspace
      .workspace-main
        .chart-area
          FootprintChart
        if studies.length > 0
          .studies-dock(style={{ height: dockHeight }})
            ResizeHandle(
              ~ direction="top"
              ~ onResize={(d) => setDockHeight((h) => clamp(h - d, 180, 560))}
              ~ )
            each item in studies
              scope
                setup const { key, Component } = item;
                .study-slot(key={key})
                  Component
      if showSidebar
        aside.sidebar(style={{ width: sidebarWidth }} ref={sidebarRef})
          ResizeHandle(
            ~ direction="left"
            ~ onResize={(d) => setSidebarWidth((w) => clamp(w - d, 260, 520))}
            ~ )
          if panels.orderBook
            .sidebar-slot(style={{ flex: panels.timeSales ? `${bookShare} 1 0` : "1 1 0" }})
              OrderBookPanel
              if panels.timeSales
                ResizeHandle(
                  ~ direction="bottom"
                  ~ onResize={(d) => {
                  ~ const total = sidebarRef.current?.clientHeight ?? 800;
                  ~ setBookShare((s) => clamp(s + d / total, 0.25, 0.8));
                  ~ }}
                  ~ )
          if panels.obi
            .sidebar-slot(style={{ flex: `0 0 ${obiHeight}px` }})
              OBIPanel
              ResizeHandle(
                ~ direction="bottom"
                ~ onResize={(d) => setObiHeight((h) => clamp(h + d, 140, 340))}
                ~ )
          if panels.timeSales
            .sidebar-slot(style={{ flex: panels.orderBook ? `${1 - bookShare} 1 0` : "1 1 0" }})
              TimeAndSales
    StatusBar
    AlertToasts
component ResizeHandle
  props { direction, onResize, }: { direction: "left" | "right" | "top" | "bottom"; onResize: (delta: number) => void }
  setup
    const start = useRef(0);
    const vertical = direction === "top" || direction === "bottom";
  span(
    ~ className={`resize-handle resize-handle-${direction}`}
    ~ role="separator"
    ~ aria-orientation={vertical ? "horizontal" : "vertical"}
    ~ onPointerDown={(event) => {
    ~ event.preventDefault();
    ~ start.current = vertical ? event.clientY : event.clientX;
    ~ const move = (moveEvent: PointerEvent) => {
    ~ const current = vertical ? moveEvent.clientY : moveEvent.clientX;
    ~ const delta = current - start.current;
    ~ if (delta !== 0) {
    ~ onResize(delta);
    ~ start.current = current;
    ~ }
    ~ };
    ~ const stop = () => {
    ~ window.removeEventListener("pointermove", move);
    ~ window.removeEventListener("pointerup", stop);
    ~ document.body.classList.remove("is-resizing", "is-resizing-row");
    ~ };
    ~ document.body.classList.add("is-resizing");
    ~ if (vertical)
    ~ document.body.classList.add("is-resizing-row");
    ~ window.addEventListener("pointermove", move);
    ~ window.addEventListener("pointerup", stop, { once: true });
    ~ }}
    ~ )


SessionContextProvider
  SessionTerminal
