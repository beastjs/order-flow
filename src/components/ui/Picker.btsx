import { Icon, IconName } from "@/lib/icons";
import { useEffect, useMemo, useRef, useState, type ClassValue } from "octane";
import type { OctaneNode, KeyboardEvent } from "octane";
module
  export interface PickerOption<T extends any> {
    value: T;
    label: string;
    sub?: string;
    icon?: IconName;
    disabled?: boolean;
    keywords?: string;
  }
  type PickerProps<T extends any> = {
    value: T
    options?: PickerOption<T>[]
    onChange?: (value: T) => void
    label?: string
    searchable?: boolean
    className?: ClassValue
    renderValue?: (current: PickerOption<string> |undefined) => OctaneNode
    width?: number
  }
  type T = any

props { value, options, onChange, label, searchable = false, className = "", renderValue, width = 280 }: PickerProps<T>
setup
  const [open, setOpen] = useState(false);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(0);
  const root = useRef<HTMLDivElement | null>(null);
  const input = useRef<HTMLInputElement | null>(null);
  const list = useRef<HTMLDivElement | null>(null);
  const current = options?.find((option) => option.value === value);

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q)
      return options;
    return options ? options.filter((o) => `${o.label} ${o.sub ?? ""} ${o.keywords ?? ""}`.toLowerCase().includes(q)) as PickerOption<typeof value>[] : [];
  }, [options, query]);

  useEffect(() => {
    if (!open)
      return;
    const close = (event: MouseEvent) => {
      if (root.current && !root.current.contains(event.target as Node))
        setOpen(false);
    };
    window.addEventListener("mousedown", close);
    requestAnimationFrame(() => input.current?.focus());
    return () => window.removeEventListener("mousedown", close);
  }, [open]);

  useEffect(() => {
    list.current?.querySelector<HTMLElement>(`[data-index="${active}"]`)?.scrollIntoView({ block: "nearest" });
  }, [active]);

  const choose = (o: PickerOption<string> | undefined) => {
    if (!o || o.disabled){
      return;
    }
    onChange?.(o.value);
    setOpen(false);
  };

  const toggle = () => {
    if (!open && options) {
      setQuery("");
      setActive(Math.max(0, options.findIndex((o) => o.value === value)));
    }
    setOpen((v) => !v);
  };

  const onKeyDown = (event: KeyboardEvent) => {
    if (!open)
      return;
    if (event.key === "Escape") {
      setOpen(false);
      event.preventDefault();
    }
    else if (event.key === "ArrowDown") {
      setActive((i) => Math.min((filtered?.length ?? 0) - 1, i + 1));
      event.preventDefault();
    }
    else if (event.key === "ArrowUp") {
      setActive((i) => Math.max(0, i - 1));
      event.preventDefault();
    }
    else if (event.key === "Enter") {
      choose(filtered?.[active]);
      event.preventDefault();
    }
  };

div.picker(ref={root} onKeyDown={onKeyDown})
  button(
    ~ type="button"
    ~ className={`ui-button picker-button ${className} ${open ? "is-open" : ""}`}
    ~ aria-haspopup="listbox"
    ~ aria-expanded={open}
    ~ aria-label={`${label}: ${current?.label ?? value}`}
    ~ onClick={toggle}
    ~ )
    if renderValue
      | #{renderValue(current)}
    else
      fragment
        if (current)
          Icon(name={current?.icon as IconName})
        span.picker-label #{current?.label ?? value}
    span.picker-chevron
      Icon(name='chevron-down' size={10})
  if open
    .picker-popover(style={{ width }} role="dialog" aria-label={label})
      if searchable
        label.picker-search
          Icon(name='search')
          input(
            ~ ref={input}
            ~ value={query}
            ~ placeholder="Search"
            ~ onInput={(e) => { setQuery(e.currentTarget.value); setActive(0); }}
            ~ aria-label={`Search ${label?.toLowerCase()}`}
            ~ )
          kbd esc
      .picker-list(role="listbox" ref={list} aria-label={label})
        if filtered?.length === 0
          .picker-empty No matches
        else
          each option, index in filtered key option.value
            button(
              ~ type="button"
              ~ data-index={index}
              ~ role="option"
              ~ aria-selected={option.value === value}
              ~ disabled={option.disabled}
              ~ className={`picker-option ${index === active ? "is-active" : ""} ${option.value === value ? "is-selected" : ""}`}
              ~ onMouseEnter={() => setActive(index)}
              ~ onClick={() => choose(option)}
              ~ )
              Icon(name={option.icon as IconName})
              span.picker-option-text
                span #{option.label}
                if option.sub
                  small #{option.sub}
              if option.value === value
                span.picker-check(aria-hidden) ●
