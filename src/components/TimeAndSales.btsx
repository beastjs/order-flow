
module "use client";
import { useSessionStore, useThrottledSessionStore } from "@/lib/session/sessionContext";
import { formatClock, formatCompact, formatPriceValue, priceDecimals, VENUE_SHORT } from "@/lib/format";
import { Icon } from "@/lib/icons";
import Panel from "@/components/ui/Panel.btsx";
import type { NormalizedLiquidation, NormalizedTrade } from "@/lib/types/market";
import { useMemo, useState, createElement } from "octane";
import type { CSSProperties, Dispatch, SetStateAction } from "octane";
import Segmented from "./ui/Segmented.btsx";
module
  // ─── Time & Sales ────────────────────────────────────────────────
  // Executed prints, newest first. Size is compared to the session's
  // average print so block trades stand out.
  const FILTERS = [
    { value: 0, label: "All" },
    { value: 2, label: "≥2×" },
    { value: 5, label: "≥5×" },
    { value: 10, label: "≥10×" },
  ] as const;
  const LIQ_FILTER = -1;
  const PERP_FILTERS = [...FILTERS, { value: LIQ_FILTER, label: "Liq" }] as const;
  type Filter = (typeof PERP_FILTERS)[number]["value"];
  const MAX_ROWS = 120;
  type TapeRow = {
    ~ kind: "trade";
    ~ key: string;
    ~ trade: NormalizedTrade;
    ~ tick: number;
    ~ ratio: number;
    ~ } | {
    ~ kind: "liq";
    ~ key: string;
    ~ liq: NormalizedLiquidation;
    ~ };
// lifted from the icon attribute
// its props type is the one thing the conversion cannot infer — annotate it
component Actions
  props { activeFilter, setFilter, isPerp } : {activeFilter: Filter, setFilter: Dispatch<SetStateAction<Filter>>, isPerp: boolean}
  Segmented(
    ~ size="xs"
    ~ value={activeFilter}
    ~ onChange={setFilter}
    ~ options={isPerp ? PERP_FILTERS : FILTERS}
    ~ ariaLabel="Minimum size vs average, or liquidations only"
    ~ )
// lifted from the footer attribute; buyShare came from the component around it
// its props type is the one thing the conversion cannot infer — annotate it
component Footer
  props { buyShare }: {buyShare: number}
  .book-imbalance(title="Aggressor split over the last 200 prints")
    span.tone-buy Buy #{(buyShare * 100).toFixed(0)}%
    .imbalance-track
      .imbalance-bid(style={{ width: `${buyShare * 100}%` }})
    span.tone-sell Sell #{((1 - buyShare) * 100).toFixed(0)}%

setup
  // The tape is read by eye: 8 updates a second instead of one per feed flush.
  const trades = useThrottledSessionStore((s) => s.recentTrades, 125);
  const session = useThrottledSessionStore((s) => s.session, 125);
  const tickSize = useSessionStore((s) => s.tickSize);
  const selectedVenues = useSessionStore((s) => s.selectedVenues);
  const marketType = useSessionStore((s) => s.marketType);
  const liquidations = useSessionStore((s) => s.liquidations);
  const [filter, setFilter] = useState<Filter>(0);
  const isPerp = marketType === "perpetual";
  const activeFilter: Filter = !isPerp && filter === LIQ_FILTER ? 0 : filter;
  const avg = session && session.trades ? session.volume / session.trades : 0;
  const decimals = priceDecimals(tickSize, trades[0]?.price);
  const showVenue = selectedVenues.length > 1;

  const rows = useMemo(() => {
    const out: TapeRow[] = [];
    // Row keys let the list move existing rows down instead of rewriting all of
    // them; a repeated id gets a suffix so keys stay unique.
    const seen = new Map<string, number>();
    const keyFor = (base: string) => {
      const count = seen.get(base) ?? 0;
      seen.set(base, count + 1);
      return count ? `${base}#${count}` : base;
    };
    if (activeFilter === LIQ_FILTER) {
      for (let i = liquidations.length - 1; i >= 0 && out.length < MAX_ROWS; i--)
        out.push({ kind: "liq", key: keyFor(`l:${liquidations[i].id}`), liq: liquidations[i] });
      return out;
    }
    // Liquidations are interleaved by time, limited to the span the tape covers.
    const oldestTrade = trades[trades.length - 1]?.timestamp ?? Infinity;
    let li = liquidations.length - 1;
    const threshold = avg * activeFilter;
    for (let i = 0; i < trades.length && out.length < MAX_ROWS; i++) {
      const trade = trades[i];
      while (li >= 0 && liquidations[li].timestamp >= trade.timestamp && out.length < MAX_ROWS) {
        if (liquidations[li].timestamp >= oldestTrade)
          out.push({ kind: "liq", key: keyFor(`l:${liquidations[li].id}`), liq: liquidations[li] });
        li--;
      }
      if (activeFilter && trade.quantity < threshold)
        continue;
      const prev = trades[i + 1];
      const tick = prev ? Math.sign(trade.price - prev.price) : 0;
      out.push({ kind: "trade", key: keyFor(`t:${trade.venue}:${trade.id}:${trade.timestamp}`), trade, tick, ratio: avg ? trade.quantity / avg : 1 });
    }
    return out;
  }, [trades, liquidations, avg, activeFilter]);

  const buyShare = useMemo(() => {
    let buy = 0;
    let total = 0;
    for (let i = 0; i < trades.length && i < 200; i++) {
      total += trades[i].quantity;
      if (trades[i].side === "buy")
        buy += trades[i].quantity;
    }
    return total ? buy / total : 0.5;
  }, [trades]);
Panel(
  ~ title="Time & Sales"
  ~ icon={'tape'}
  ~ subtitle={avg ? `avg print ${formatCompact(avg, 3)}` : "executed prints"}
  ~ className="tape-panel"
  ~ actions={createElement(Actions, { activeFilter, setFilter, isPerp })}
  ~ footer={createElement(Footer, { buyShare })}
  ~ )
  div(className={`tape ${showVenue ? "with-venue" : ""}`})
    .tape-head
      span Time
      span Price
      span Size
      if showVenue
        span Venue
    .tape-body
      if rows.length === 0
        .empty-state
          if activeFilter === LIQ_FILTER
            | #{"No liquidations yet this session"}
          elseif trades.length
            | #{"No prints match the filter"}
          else
            | #{"Waiting for trades…"}
      each row in rows key row.key
        fragment
          if row.kind === "liq"
            scope
              setup
                const { liq } = row;
                const side = liq.side === "long" ? "sell" : "buy";
              div(
                ~ className={`tape-row ${side} is-liq`}
                ~ title={`${liq.side === "long" ? "Long" : "Short"} liquidated: ${liq.quantity} @ ${liq.price} ($${formatCompact(liq.quoteVolume, 2)}) on ${VENUE_SHORT[liq.venue] ?? liq.venue}`}
                ~ )
                span.tape-time
                  b.liq-tag LIQ #{liq.side === "long" ? "L" : "S"}
                  | #{formatClock(liq.timestamp)}
                span.tape-price #{formatPriceValue(liq.price, decimals)}
                span.tape-size $#{formatCompact(liq.quoteVolume, 1)}
                if showVenue
                  span.tape-venue #{VENUE_SHORT[liq.venue] ?? liq.venue}
          else
            scope
              setup
                const { trade, tick, ratio } = row;
                const heat = Math.min(1, Math.max(0, (ratio - 1) / 9));
              div(
                ~ className={`tape-row ${trade.side} ${ratio >= 5 ? "is-block" : ""}`}
                ~ style={{ "--heat": heat.toFixed(3) } as CSSProperties}
                ~ title={`${trade.side === "buy" ? "Buy" : "Sell"} ${trade.quantity} @ ${trade.price} · ${ratio.toFixed(1)}× average${marketType === "forex" ? " (tick)" : ""}`}
                ~ )
                span.tape-time #{formatClock(trade.timestamp, true)}
                span.tape-price
                  | #{formatPriceValue(trade.price, decimals)}
                  i(className={`tick-arrow ${tick > 0 ? "up" : tick < 0 ? "down" : ""}`})
                span.tape-size #{formatCompact(trade.quantity, 3)}
                if showVenue
                  span.tape-venue #{VENUE_SHORT[trade.venue] ?? trade.venue}
