import { createElement, useState } from "octane";
import { Icon } from "@/lib/icons";
import Menu, { MenuSection } from "@/components/ui/Menu.btsx";
import { isFirebaseConfigured } from "@/lib/firebase";
import { signInWithGoogle, signOutUser, useFirebaseUser, useRememberedAccounts } from "@/lib/firebase/auth";
import { getAccountLabel } from "@/lib/firebase/accounts";
import { adminRoutePrefix, toAdminSubdomainHostname } from "@/lib/routing/admin-console";
import { asgardRoutePrefix, toAsgardSubdomainHostname } from "@/lib/routing/asgard-console";
import { supportsConsoleSubdomain } from "@/lib/routing/console-host";
import TopUpModal from "./TopUpModal.btsx";
import OkxConnectionModal from "@/components/app/OkxConnectionModal.btsx";
import { useConvexAuth, useConvexQuery } from "@/hooks/useConvex";
import { api } from "@@/convex/_generated/api";
// ─── Sign-in button ─────────────────────────────────────────────
// Signed out: an icon-only button that opens Google sign-in.
// Signed in: the user's avatar, opening a menu with the account,
// previously used accounts to switch to, and sign out.
module
  export { Avatar, errorMessage as signInErrorMessage }
  // Closing the Google popup is the user changing their mind, not an error.
  const QUIET_ERRORS = new Set(["auth/popup-closed-by-user", "auth/cancelled-popup-request"])

  function errorMessage(error: unknown): string | null {
    const code = (error as { code?: string })?.code
    if (code && QUIET_ERRORS.has(code)) return null
    if (code === "auth/popup-blocked") return "Allow pop-ups for this site to sign in."
    return error instanceof Error ? error.message : "Sign-in failed."
  }

  function initials(name: string | null | undefined, email: string | null | undefined): string {
    const source = (name || email || "?").trim()
    const parts = source.split(/[\s@._-]+/).filter(Boolean)
    return ((parts[0]?.[0] ?? "?") + (name && parts[1] ? parts[1][0] : "")).toUpperCase()
  }

  function consoleHref(fallbackPath: string, toSubdomainHostname: (hostname: string) => string): string {
    const url = new URL(window.location.origin);
    if (!supportsConsoleSubdomain(url.hostname)) return fallbackPath;
    url.hostname = toSubdomainHostname(url.hostname);
    return url.href;
  }

component Avatar
  props { photoURL, name, email, size = 30 }: { photoURL: string | null; name: string | null; email: string | null; size?: number }
  setup const [failed, setFailed] = useState(false);
  div.account-avatar(style={{ width: size, height: size, fontSize: Math.round(size * 0.4) }} aria-hidden)
    if photoURL && !failed
      // Google profile photos 403 when a Referer is sent.
      img(src={photoURL} alt="user-avatar" referrerPolicy="no-referrer" onError={() => setFailed(true)})
    else
      span #{initials(name, email)}

component Item
  props { label, hint, disabled, onClick }: { label: string; hint?: string; disabled?: boolean; onClick: VoidFunction }
  button(className="menu-item menu-action" type="button" role="menuitem" disabled={disabled} onClick={onClick})
    span.menu-item-text
      span #{label}
      if hint
        small #{hint}

component AccountItems
  props { onError, onTopUp, onOkx }: { onError: (message: string | null) => void; onTopUp: () => void; onOkx: () => void }
  setup
    const { user, isLoading, hasAdminClaim, hasGodAccess } = useFirebaseUser();
    const accounts = useRememberedAccounts();
    const authed = useConvexAuth().isAuthenticated;
    const usdBalance = useConvexQuery(api.funds.usd, authed ? {} : "skip").data;
    const usdLabel = usdBalance === undefined || usdBalance === null ? "USD balance" : `USD balance · $${usdBalance.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    const others = accounts.filter((a) => a.uid !== user?.uid && a.email);
    const run = (task: Promise<unknown>) => task.then(() => onError(null), (e) => onError(errorMessage(e)));
  .account-menu
    if user
      .account-menu-head
        Avatar(photoURL={user.photoURL} name={user.displayName} email={user.email} size={36})
        .account-menu-id
          strong #{user.displayName ?? user.email ?? "Signed in"}
          if user.displayName && user.email
            span #{user.email}
    MenuSection(title="Funds")
      Item(label={usdLabel} hint="Top up" disabled={!authed} onClick={onTopUp})
      Item(label="My OKX" hint="API connection" disabled={!authed} onClick={onOkx})
    if user && !isLoading && (hasAdminClaim || hasGodAccess)
      MenuSection(title="Consoles")
        if hasAdminClaim
          a.menu-item.menu-action(href={consoleHref(adminRoutePrefix, toAdminSubdomainHostname)} role="menuitem")
            span.menu-item-text
              span Admin
        if hasGodAccess
          a.menu-item.menu-action(href={consoleHref(asgardRoutePrefix, toAsgardSubdomainHostname)} role="menuitem")
            span.menu-item-text
              span Asgard
    if others.length
      MenuSection(title="Switch account")
        each a in others key a.uid
          Item(label={getAccountLabel(a)} hint={a.displayName ? a.email ?? undefined : undefined} onClick={() => run(signInWithGoogle(a.email ?? undefined))})
    MenuSection(title="Session")
      Item(label="Use another account" onClick={() => run(signInWithGoogle())})
      Item(label="Sign out" onClick={() => run(signOutUser())})

setup
  const { user, isLoading } = useFirebaseUser();
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [topUpOpen, setTopUpOpen] = useState(false);
  const [okxUser, setOkxUser] = useState<string | null>(null);
  const signIn = () => {
    setBusy(true);
    setError(null);
    signInWithGoogle()
      .catch((e) => setError(errorMessage(e)))
      .finally(() => setBusy(false));
  };
  const label = !isFirebaseConfigured ? "Sign-in unavailable" : error ?? (busy ? "Signing in…" : "Sign in with Google");

fragment
  if user
    Menu(
      ~ hint="Account"
      ~ buttonClassName="account-trigger"
      ~ label={createElement(Avatar, { photoURL: user.photoURL, name: user.displayName, email: user.email })}
      ~ )
      AccountItems(onError={setError} onTopUp={() => setTopUpOpen(true)} onOkx={() => setOkxUser(user.uid)})
  else
    button(
      ~ className="account-signin"
      ~ type="button"
      ~ aria-label={label}
      ~ title={label}
      ~ data-hint={label}
      ~ data-error={error ? "1" : undefined}
      ~ aria-busy={busy || isLoading}
      ~ disabled={!isFirebaseConfigured || busy}
      ~ onClick={signIn}
      ~ )
      Icon(name="user-settings" size={24})
  TopUpModal(open={topUpOpen && Boolean(user)} onClose={() => setTopUpOpen(false)})
  if user && okxUser === user.uid
    OkxConnectionModal(onClose={() => setOkxUser(null)})
