module "use client";
import { useMarketSession, useSessionStore } from "@/lib/session/sessionContext";
import { TAPE_LOG_SIZE } from "@/lib/managers/marketDataManager";
import { formatCompact, VENUE_LABEL } from "@/lib/format";
import { Icon } from "@/lib/icons";
import { useState, createElement } from "octane";
import Menu, { MenuSection } from "./ui/Menu.btsx";
// ─── Export menu ─────────────────────────────────────────────────
// CSV of the session's footprint, profile, tape and derivatives series,
// and PNG snapshots of the charts.
component Item
  props { label, hint, disabled, onClick }: { label: string; hint: string; disabled?: boolean; onClick: () => void | Promise<void> }
  button(
    ~ className="menu-item menu-action"
    ~ type="button"
    ~ role="menuitem"
    ~ disabled={disabled}
    ~ onClick={() => void onClick()}
    ~ )
    span.menu-item-text
      span #{label}
      small #{hint}
// lifted from the label attribute
component Label
  fragment
    Icon(name='download')

    span.hide-compact Export
component ExportItems
  setup
    const session = useMarketSession();
    const store = session.store;
    const symbol = useSessionStore((s) => s.symbol);
    const timeframe = useSessionStore((s) => s.timeframe);
    const marketType = useSessionStore((s) => s.marketType);
    const candleCount = useSessionStore((s) => s.candles.length + (s.currentCandle ? 1 : 0));
    const hasProfile = useSessionStore((s) => Boolean(s.volumeProfile?.levels.length));
    const liqCount = useSessionStore((s) => s.liquidations.length);
    const oiCount = useSessionStore((s) => s.oiHistory.length);
    const [error, setError] = useState<string | null>(null);
    // The CSV and image code is loaded on the first export.
    const tools = async () => {
      const [csv, download] = await Promise.all([import("@/lib/export/csv"), import("@/lib/export/download")]);
      const name = (kind: string, ext = "csv") => csv.exportFilename(symbol, timeframe, kind, ext);
      return { ...csv, ...download, name };
    };

    const candles = () => {
      const s = store.getState();
      return s.currentCandle ? [...s.candles, s.currentCandle] : s.candles;
    };

    const run = async (fn: () => void | Promise<void>) => {
      setError(null);
      try {
        await fn();
      }
      catch (e) {
        setError(e instanceof Error ? e.message : String(e));
      }
    };

    const isPerp = marketType === "perpetual";
    const tapeSize = session.manager.tapeLogSize;
  .export-menu
    MenuSection(title="CSV")
      Item(
        ~ label="Footprint candles"
        ~ hint={`${candleCount} candles · OHLC, volume, delta, CVD, VWAP`}
        ~ disabled={!candleCount}
        ~ onClick={() => run(async () => { const t = await tools(); t.downloadText(t.candlesCsv(candles()), t.name("candles")); })}
        ~ )
      Item(
        ~ label="Footprint levels"
        ~ hint="Bid / ask volume per price per candle"
        ~ disabled={!candleCount}
        ~ onClick={() => run(async () => { const t = await tools(); t.downloadText(t.footprintLevelsCsv(candles()), t.name("footprint")); })}
        ~ )
      Item(
        ~ label="Session profile"
        ~ hint="Volume by price with POC and value area"
        ~ disabled={!hasProfile}
        ~ onClick={() => run(async () => { const t = await tools(); const p = store.getState().volumeProfile; if (p)
        ~ t.downloadText(t.profileCsv(p), t.name("profile")); })}
        ~ )
      Item(
        ~ label="Time & sales"
        ~ hint={`Last ${formatCompact(Math.min(tapeSize, TAPE_LOG_SIZE), 0)} prints (up to ${formatCompact(TAPE_LOG_SIZE, 0)})`}
        ~ disabled={!tapeSize}
        ~ onClick={() => run(async () => { const t = await tools(); t.downloadText(t.tapeCsv(session.manager.getTapeLog()), t.name("tape")); })}
        ~ )
      if isPerp
        fragment
          Item(
            ~ label="Liquidations"
            ~ hint={`${liqCount} this session`}
            ~ disabled={!liqCount}
            ~ onClick={() => run(async () => { const t = await tools(); t.downloadText(t.liquidationsCsv(store.getState().liquidations), t.name("liquidations")); })}
            ~ )
          Item(
            ~ label="Open interest"
            ~ hint={`${oiCount} one-second samples`}
            ~ disabled={!oiCount}
            ~ onClick={() => run(async () => { const t = await tools(); t.downloadText(t.openInterestCsv(store.getState().oiHistory), t.name("open-interest")); })}
            ~ )
    MenuSection(title="Image")
      Item(
        ~ label="Footprint PNG"
        ~ hint="The footprint chart at screen resolution"
        ~ disabled={!candleCount}
        ~ onClick={() => run(async () => {
        ~ const canvas = document.querySelector<HTMLCanvasElement>(".footprint-panel canvas");
        ~ if (!canvas)
        ~ throw new Error("Footprint chart is not visible");
        ~ const t = await tools();
        ~ t.downloadBlob(await t.canvasPng(canvas), t.name("footprint", "png"));
        ~ })}
        ~ )
      Item(
        ~ label="Workspace PNG"
        ~ hint="All chart panels composited into one image"
        ~ onClick={() => run(async () => {
        ~ const root = document.querySelector<HTMLElement>(".workspace");
        ~ if (!root)
        ~ throw new Error("Workspace not found");
        ~ const s = store.getState();
        ~ const venue = s.selectedVenues.length > 1 ? VENUE_LABEL[s.venue] ?? s.venue : VENUE_LABEL[s.selectedVenues[0]] ?? s.venue;
        ~ const caption = `orderflow. · ${s.symbol} · ${venue} · ${s.timeframe.toUpperCase()} · ${new Date(s.replay ? s.replay.position : Date.now()).toISOString().slice(0, 19).replace("T", " ")} UTC${s.replay ? " (replay)" : ""}`;
        ~ const t = await tools();
        ~ t.downloadBlob(await t.workspacePng(root, caption), t.name("workspace", "png"));
        ~ })}
        ~ )
    if error
      div(className="menu-note tone-sell") #{error}

Menu(hint="Export" label={createElement(Label, {})})
  ExportItems
