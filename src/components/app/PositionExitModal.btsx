import { useId, useLayoutEffect, useRef, useState } from "octane";
import ScrubField from "@/components/ui/scrubfield.btsx";
import Squishy from "@/components/ui/squishy.btsx";
import { convexErrorMessage } from "@/hooks/useConvex";
import type { OpenPositionRow } from "@/hooks/usePaperAccount";
import { liquidationPrice, netPnlAtExit, validateExitTargets, validateTotalExitTargets, type ExitTargets } from "@/lib/paper/math";
import { AssetGlyph } from "./AssetIndex.btsx";
import { fmtExitPrice } from "./assetFormat";

module
  type ExitScope = { row: OpenPositionRow; total?: never } | { row?: never; total: { targets: ExitTargets | null; margin: number } };
  const MAX_TARGET = Number.MAX_SAFE_INTEGER / 100;

props { row, total, mode, onSave, onClose }: ExitScope & { mode: "cloud" | "local"; onSave: (targets: ExitTargets) => Promise<string | null>; onClose: () => void }
setup
  const position = row?.position;
  const saved = position?.exitTargets ?? total?.targets;
  const titleId = useId();
  const dialogRef = useRef<HTMLDialogElement | null>(null);
  const [stopEnabled, setStopEnabled] = useState(saved?.stopLoss != null);
  const [profitEnabled, setProfitEnabled] = useState(saved?.takeProfit != null);
  const [stopLoss, setStopLoss] = useState(saved?.stopLoss ?? 0);
  const [takeProfit, setTakeProfit] = useState(saved?.takeProfit ?? 0);
  const [error, setError] = useState<string | null>(null);
  const [saving, setSaving, getSaving] = useState(false);
  const minLoss = position ? Math.min(0, (Math.floor(netPnlAtExit(position, liquidationPrice(position)) * 100) + 1) / 100)
    : Math.min(-MAX_TARGET, saved?.stopLoss ?? 0);
  const maxProfit = !position || position.side === "up" ? MAX_TARGET :
    Math.max(0, (Math.ceil(netPnlAtExit(position, 0) * 100) - 1) / 100);
  const profitLimit = position ? maxProfit / 8 : Math.max(MAX_TARGET, saved?.takeProfit ?? 0);
  const dragStep = Math.max(0.01, Math.round(position?.margin ?? total?.margin ?? 0) / 100);

  useLayoutEffect(() => {
    const dialog = dialogRef.current;
    dialog?.showModal();
    return () => dialog?.close();
  }, []);

  const save = async (event: SubmitEvent) => {
    event.preventDefault();
    if (getSaving()) return;
    const targets = { stopLoss: stopEnabled ? stopLoss : null, takeProfit: profitEnabled ? takeProfit : null };
    const invalid = position ? validateExitTargets(position, targets) : validateTotalExitTargets(targets);
    if (invalid) {
      setError(invalid);
      return;
    }
    setSaving(true);
    setError(null);
    try {
      const issue = await onSave(targets);
      if (issue) setError(issue);
      else onClose();
    } catch (issue) {
      setError(convexErrorMessage(issue));
    } finally {
      setSaving(false);
    }
  };

dialog.pos-exit-dialog(
  ~ className='dark:border-(--border)!'
  ~ aria-labelledby={titleId}
  ~ ref={dialogRef}
  ~ onCancel={(event: Event) => { event.preventDefault(); if (!getSaving()) onClose(); }}
  ~ )
  form.pos-exit-form(onSubmit={save})
    header
      h2(id={titleId} className="flex items-center gap-2.5")
        if row
          fragment
            span(aria-hidden="true")
              AssetGlyph(base={row.base} size={24})
            span
              | #{row.base + " "}
              span(className='font-sans! font-[450] px-2!') Exit Strategy
        else
          | Total TP/SL
      if total
        p Close all open paper positions when combined P&L after fees reaches either target.
    .pos-exit-target
      Squishy(
        ~ height={20}
        ~ width={32}
        ~ label="Stop loss"
        ~ className="pos-exit-toggle w-full! capitalize!"
        ~ checked={stopEnabled}
        ~ disabled={saving || minLoss === 0}
        ~ trackColor="var(--text-muted)"
        ~ trackOnColor="#f0f0f0"
        ~ thumbColor="var(--border)"
        ~ thumbOnColor="var(--bg-base)"
        ~ onChange={(checked: boolean) => { setStopEnabled(checked); setError(null); }}
        ~ )
      ScrubField(
        ~ label={position ? fmtExitPrice(position, stopLoss) : "Net P&L"}
        ~ ariaLabel={total ? "Total stop loss PnL" : "Stop loss PnL"}
        ~ suffix="USD"
        ~ value={stopLoss}
        ~ min={minLoss}
        ~ max={0}
        ~ step={0.01}
        ~ dragStep={dragStep}
        ~ size="lg"
        ~ rubberReach={0}
        ~ showFill={true}
        // ~ accent="#ff5c74"
        ~ accent="#fafafa"
        ~ chipColor="#ff5c74"
        ~ className="w-full! text-white! border border-(--border)! disabled:border-(--border-muted)! focus-within:border-(--text-muted)!"
        ~ disabled={saving || !stopEnabled}
        ~ onChange={(value: number) => { setStopLoss(value); setError(null); }}
        ~ labelColor='text-white!'
        ~ )
    .pos-exit-target
      Squishy(
        ~ height={20}
        ~ width={32}
        ~ label="Take profit"
        ~ className="pos-exit-toggle"
        ~ checked={profitEnabled}
        ~ disabled={saving || maxProfit === 0}
        ~ trackColor="var(--text-muted)"
        ~ trackOnColor="#f0f0f0"
        ~ thumbColor="var(--border)"
        ~ thumbOnColor="var(--bg-base)"
        ~ onChange={(checked: boolean) => { setProfitEnabled(checked); setError(null); }}
        ~ )

      ScrubField(
        ~ label={position ? fmtExitPrice(position, takeProfit) : "Net P&L"}
        ~ labelColor='text-(--bg-base)'
        ~ ariaLabel={total ? "Total take profit PnL" : "Take profit PnL"}
        ~ suffix="USD"
        ~ value={takeProfit}
        ~ min={0}
        ~ max={profitLimit}
        ~ step={0.01}
        ~ dragStep={dragStep}
        ~ size="lg"
        ~ rubberReach={0}
        ~ showFill={true}
        ~ accent="#2fd897"
        ~ chipColor="#dddddd40"
        ~ className="w-full!  _border border-(--border)! disabled:border-(--border-muted)! focus-within:border-(--text-muted)!"
        ~ disabled={saving || !profitEnabled}
        ~ onChange={(value: number) => { setTakeProfit(value); setError(null); }}
        ~ )
    if total
      p.pos-exit-note #{mode === "cloud" ? "Checked every minute." : "Checked as prices update while the app is open."} Targets clear when all positions close.
    if error
      p.sim-error(role="alert") #{error}
    footer
      button.pos-close(className="rounded-lg! bg-(--border)!" type="button" disabled={saving} onClick={onClose}) Cancel
      button.lp-btn.lp-btn-primary(className="justify-center rounded-lg!" type="submit" disabled={saving}) #{saving ? "Saving…" : "Save Targets"}
