import { useLayoutEffect, useRef, useState } from "octane";
import { animate, useReducedMotion, type Transition } from "@octanejs/motion";
import { okxChangePct, useInView, useOkxSparkline, useOkxTicker } from "@/hooks/useOkx";
import { useHlAssetCtx, useHlSparkline } from "@/hooks/useHyperliquid";
import { Link } from "@octanejs/tanstack-router";
import type { OkxTicker } from "@/lib/okx";
import { hlChangePct, type HlAssetCtx } from "@/lib/hyperliquid";
import { assetIdOf, CATEGORY_LABEL, fmtCompact, fmtPrice, glyphSrc, sparkPaths, venueSearch, type AssetIndexItem, type MarketVenue } from "./assetFormat";
import { cn } from "@/lib/utils";

module
  export { AssetGlyph }

  const sparkWidth = 240;
  const sparkHeight = 56;
  const sparkBaseline = sparkHeight / 2;
  const sparkPlaceholder = `M0,${sparkBaseline} L${sparkWidth},${sparkBaseline}`;
  const sparklineEntry: Transition = { type: "tween", duration: 0.15, ease: [0.23, 1, 0.32, 1] };

  /** What a card shows, whichever venue it streams from. */
  interface CardQuote {
    last?: number
    change: number | null
    turnover: number
    foot: string
  }

component AssetGlyph
  props { base, venue = "okx", coin, size=22 }: { base: string; venue?: MarketVenue; coin?: string, size?: number }
  setup const [failed, setFailed] = useState(false);
  span.asset-glyph
    if failed
      span.asset-glyph-mono #{base.slice(0, base.length > 3 ? 2 : 3)}
    else
      img(
        ~ src={glyphSrc(coin ?? base, venue)}
        ~ alt={base}
        ~ loading="lazy"
        ~ width={size}
        ~ height={size}
        ~ className={`size-[${size}px]!`}
        ~ onError={() => setFailed(true)}
        ~ )

component AssetCardView
  props { item, quote, closes, cardRef }: { item: AssetIndexItem; quote: CardQuote; closes: number[]; cardRef: { current: HTMLElement | null } }
  setup
    const venue = item.venue ?? "okx";
    const series = quote.last !== undefined && closes.length ? [...closes.slice(0, -1), quote.last] : closes;
    const paths = sparkPaths(series, sparkWidth, sparkHeight);
    const up = (quote.change ?? 0) >= 0;
    const gradId = `spark-${venue}-${item.instId}`;
  Link.asset-index-link(to="/perps/$assetId" params={{ assetId: assetIdOf({ ...item, venue }) }} search={venueSearch(venue)} aria-label={`${item.base} perpetual`})
    article.asset-index(className='dark:hover:shadow-[inset_0px_1px_0px_0px_rgba(255,255,255,0.18)]! ' ref={cardRef} data-up={up ? "1" : "0"} data-category={item.category})
      header.asset-index-head
        AssetGlyph(base={item.base} venue={venue} coin={item.instId} size={24})
        .asset-index-name
          strong #{item.base}
          span #{item.dex ? `${CATEGORY_LABEL[item.category]} · ${item.dex}` : CATEGORY_LABEL[item.category]}
        if item.preMarket
          span.asset-index-tag Pre-IPO
        elseif item.maxLeverage
          span.asset-index-tag #{item.maxLeverage}⛌
      .asset-index-price
        span.asset-index-last #{quote.last !== undefined ? fmtPrice(quote.last, item.tickSz) : "—"}
        span.asset-index-change(className={cn( up ? "is-up" : "is-down")})
          | #{quote.change === null ? "" : `${up ? "+" : ""}${quote.change.toFixed(1)}%`}
      svg.asset-index-spark(viewBox={`0 0 ${sparkWidth} ${sparkHeight}`} preserveAspectRatio="none" aria-hidden)
        defs
          linearGradient(id={gradId} x1="0" x2="0" y1="0" y2="1")
            stop(offset="0%" stop-color="currentColor" stop-opacity="0.22")
            stop(offset="100%" stop-color="currentColor" stop-opacity="0")
        if paths
          scope
            setup
              const reduceMotion = useReducedMotion();
              const line = useRef<SVGPathElement | null>(null);
              const area = useRef<SVGPathElement | null>(null);
              const [morphing, setMorphing] = useState(!reduceMotion);
              const flatLine = morphing ? paths.points.map(([x], index) => `${index ? "L" : "M"}${x.toFixed(1)},${sparkBaseline}`).join(" ") : "";
              const flatArea = `${flatLine} L${sparkWidth},${sparkBaseline} L0,${sparkBaseline} Z`;
              useLayoutEffect(() => {
                if (!line.current || !area.current) return;
                if (!morphing) {
                  const fade = animate(area.current, { opacity: [0, 1] }, sparklineEntry);
                  return () => fade.stop();
                }
                const lineEntrance = animate(line.current, { d: [flatLine, paths.line] }, sparklineEntry);
                const areaEntrance = animate(area.current, { d: [flatArea, paths.area] }, sparklineEntry);
                let active = true;
                void lineEntrance.then(() => { if (active) setMorphing(false); });
                return () => {
                  active = false;
                  lineEntrance.stop();
                  areaEntrance.stop();
                };
              }, []);
            g
              path(ref={area} d={morphing ? flatArea : paths.area} fill={`url(#${gradId})`})
              path(ref={line} d={morphing ? flatLine : paths.line} fill="none" stroke="currentColor" stroke-width="1.4" vector-effect="non-scaling-stroke")
        else
          path(d={sparkPlaceholder} fill="none" stroke="currentColor" stroke-width="1.4" vector-effect="non-scaling-stroke")
      // footer.asset-index-foot
      //   span(className='text-(--text-secondary)') Vol #{fmtCompact(quote.turnover)}
      //   span(className='tracking-tightest') #{quote.foot}

component OkxCard
  props { item, initial, live }: { item: AssetIndexItem; initial?: OkxTicker; live: boolean }
  setup
    const { ref, visible, seen } = useInView<HTMLElement>("300px");
    // Stream only while on screen; keep the last live print when scrolled away.
    const streamed = useOkxTicker(live && visible ? item.instId : null, 1000);
    const last = useRef<OkxTicker | undefined>(undefined);
    if (streamed) last.current = streamed;
    const ticker = streamed ?? last.current ?? initial;
    const closes = useOkxSparkline(item.instId, seen);
    const quote: CardQuote = {
      last: ticker?.last,
      change: okxChangePct(ticker, "24h"),
      turnover: ticker ? ticker.volCcy24h * ticker.last : NaN,
      foot: ticker ? `H ${fmtPrice(ticker.high24h, item.tickSz)} · L ${fmtPrice(ticker.low24h, item.tickSz)}` : "",
    };
  AssetCardView(item={item} quote={quote} closes={closes} cardRef={ref})

component HlCard
  props { item, initial, live }: { item: AssetIndexItem; initial?: HlAssetCtx; live: boolean }
  setup
    const { ref, visible, seen } = useInView<HTMLElement>("300px");
    const streamed = useHlAssetCtx(live && visible ? item.instId : null, 1000);
    const last = useRef<HlAssetCtx | undefined>(undefined);
    if (streamed) last.current = streamed;
    const ctx = streamed ?? last.current ?? initial;
    const closes = useHlSparkline(item.instId, seen);
    const quote: CardQuote = {
      last: ctx ? ctx.midPx ?? ctx.markPx : undefined,
      change: hlChangePct(ctx),
      turnover: ctx ? ctx.dayNtlVlm : NaN,
      foot: ctx ? `OI $${fmtCompact(ctx.openInterest * ctx.markPx)} · Fund ${(ctx.funding * 100).toFixed(4)}%` : "",
    };
  AssetCardView(item={item} quote={quote} closes={closes} cardRef={ref})

props { item, initial, live = true }: { item: AssetIndexItem; initial?: OkxTicker | HlAssetCtx; live?: boolean }

if item.venue === "hyperliquid"
  HlCard(item={item} initial={initial as HlAssetCtx | undefined} live={live})
else
  OkxCard(item={item} initial={initial as OkxTicker | undefined} live={live})
