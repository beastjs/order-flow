import { useEffect, useSyncExternalStore } from "octane";
import { useConvexAuth } from "@/hooks/useConvex";
import { usePaperQuotes } from "@/hooks/usePaperQuotes";
import { fetchTicker, findPerp } from "@/lib/okx";
import { fetchHlBookQuote, fetchHlPaperMarket } from "@/lib/hyperliquid/rest";
import { hlPaperCoin } from "@/lib/paper/instruments";
import { paperStore, validateFollowUpOrder, type FollowUpOrder } from "@/lib/paper/paper";

module
  async function priceFollowUp(order: FollowUpOrder) {
    try {
      const coin = hlPaperCoin(order.instId);
      if (coin) {
        const [instrument, quote] = await Promise.all([fetchHlPaperMarket(coin), fetchHlBookQuote(coin)]);
        const entry = order.side === "up" ? quote.ask : quote.bid;
        const error = validateFollowUpOrder(order, instrument.maxLeverage) ?? (entry > 0 ? null : "Waiting for an executable market quote.");
        return error ? { error } : { entry };
      }
      const [instrument, ticker] = await Promise.all([findPerp(order.instId), fetchTicker(order.instId)]);
      if (!instrument || instrument.state !== "live" || instrument.settleCcy !== "USDT") {
        return { error: "The selected perpetual is unavailable." } as const;
      }
      const error = validateFollowUpOrder(order, instrument.maxLeverage || 1);
      return error ? { error } : { entry: order.side === "up" ? ticker.askPx : ticker.bidPx };
    } catch {
      return { error: "Could not get a market quote." } as const;
    }
  }

setup
  const auth = useConvexAuth();
  const { positions, totalExitTargets, pendingFollowUps } = useSyncExternalStore(paperStore.subscribe, paperStore.get, paperStore.get);
  const pending = pendingFollowUps?.[0];
  const enabled = !auth.isLoading && !auth.isAuthenticated;
  const ids = enabled ? Object.values(positions)
    .filter((position) => totalExitTargets || position.exitTargets || position.followUpOrder || hlPaperCoin(position.instId))
    .map((position) => position.instId) : [];
  const paperQuote = usePaperQuotes(ids, 250);

  useEffect(() => {
    if (!enabled || !pending) return;
    let active = true;
    void priceFollowUp(pending.order).then((quote) => {
      const complete = () => { if (active) paperStore.completeFollowUp(pending, quote); };
      if (!active) return;
      if (navigator.locks) return navigator.locks.request("cfx-paper-follow-up", complete).catch(complete);
      complete();
    });
    return () => { active = false; };
  }, [enabled, pending]);

  useEffect(() => {
    if (!enabled) return;
    if (totalExitTargets) {
      paperStore.checkTotalExitTargets(paperQuote);
    }
    for (const id of ids) {
      const { mark, bid, ask } = paperQuote(id);
      if (mark === undefined) continue;
      paperStore.checkExitTargets(id, mark, { bid, ask });
    }
  }, [positions, totalExitTargets, enabled, paperQuote]);
