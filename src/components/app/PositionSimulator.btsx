import { useEffect, useRef, useState } from "octane";
import type { OkxTicker } from "@/lib/okx";
import { MAINT_MARGIN, TAKER_FEE, liquidationPrice, metrics, openPosition, type PaperSide } from "@/lib/paper/math";
import { maxMargin, usePaperAccount, type SimResult } from "@/hooks/usePaperAccount";
import { useLiveAccount } from "@/hooks/useLiveAccount";
import { fmtPct, fmtPrice, fmtSize } from "./assetFormat";
import { cn } from "@/lib/utils";

module
  // Round first so a value like −0.001 prints "$0.00", not "−$0.00".
  const usd = (v: number | null | undefined, signed = false) => {
    if (v === null || v === undefined || !Number.isFinite(v)) return "—"
    const cents = Math.round(v * 100) / 100
    return `${signed && cents > 0 ? "+" : cents < 0 ? "−" : ""}$${Math.abs(cents).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
  }

  function leverageStops(max: number): number[] {
    return [...new Set([1, 2, 5, 10, 20, 50, 100].filter((x) => x < max).concat(max))]
  }

props { instId, base, tickSz, maxLeverage, ticker, markPx }: { instId: string; base: string; tickSz?: number; maxLeverage: number; ticker: OkxTicker | null; markPx?: number }
setup
  const account = usePaperAccount(instId);
  // Paper (simulated) vs Live (real market orders on the platform OKX account).
  const [venue, setVenue] = useState<"paper" | "live">("paper");
  const liveAcct = useLiveAccount(instId, venue === "live");
  const liveCfg = liveAcct.config;
  const canLive = Boolean(liveCfg?.canTrade);
  const isLive = venue === "live" && canLive;
  const position = isLive ? liveAcct.position : account.position;
  const effMaxLeverage = isLive ? Math.max(1, Math.min(maxLeverage, liveCfg?.maxLeverage ?? 1)) : maxLeverage;
  const [confirming, setConfirming] = useState(false);
  const [side, setSide] = useState<PaperSide>("up");
  const [amount, setAmount] = useState("");
  // Until the user types an amount, it follows the available balance.
  const touched = useRef(false);
  const typeAmount = (value: string) => {
    touched.current = true;
    setAmount(value);
  };
  const [leverage, setLeverage] = useState(Math.min(10, maxLeverage));
  const [error, setError] = useState<string | null>(null);
  const [lastFill, setLastFill] = useState<SimResult | null>(null);
  const [busy, setBusy] = useState<"open" | "close" | "reset" | null>(null);

  useEffect(() => {
    setLeverage((l) => Math.min(Math.max(1, l), effMaxLeverage));
  }, [effMaxLeverage]);

  // Switching venue: drop any pending confirmation and stale result.
  useEffect(() => {
    setConfirming(false);
    setLastFill(null);
    setError(null);
  }, [venue]);

  const last = ticker?.last;
  const mark = markPx ?? last;
  const quote = { bid: ticker?.bidPx || last, ask: ticker?.askPx || last };
  // Market orders cross the spread: buy at ask, sell at bid.
  const entryFor = (s: PaperSide) => (s === "up" ? quote.ask : quote.bid);
  const exitFor = (s: PaperSide) => (s === "up" ? quote.bid : quote.ask);

  const margin = Number(amount);
  const available = isLive ? liveAcct.balance : account.balance;
  // Live: also capped by the server's per-order notional limit.
  const orderCap = isLive && liveCfg ? Math.floor((liveCfg.maxOrderUsd / leverage) * 100) / 100 : Infinity;
  const affordable = available === null ? null : Math.min(maxMargin(available, leverage), orderCap);
  const loading = isLive ? liveAcct.loading : account.mode === "cloud" && account.loading;
  const inFlight = isLive && (liveAcct.status === "opening" || liveAcct.status === "closing");
  const overBalance = affordable !== null && margin > affordable;
  const entryEst = entryFor(side);
  const preview = margin > 0 && entryEst ? openPosition(instId, side, margin, leverage, entryEst) : null;
  const live = position && mark ? metrics(position, mark) : null;

  // Practice mode only: the client is the risk engine. Signed in, the server sweep liquidates.
  useEffect(() => {
    if (account.mode !== "local" || !position || !mark) return;
    const liq = liquidationPrice(position);
    if (position.side === "up" ? mark <= liq : mark >= liq) setLastFill(account.liquidateLocal(liq));
  }, [account.mode, position, mark]);

  const run = async (kind: "open" | "close" | "reset", task: () => Promise<string | null>) => {
    setBusy(kind);
    setError(null);
    try {
      setError(await task());
    } finally {
      setBusy(null);
    }
  };
  const submit = () => {
    // Real money: first tap shows exactly what will be sent; second tap sends it.
    if (isLive && !confirming) {
      setConfirming(true);
      return;
    }
    setConfirming(false);
    return run("open", async () => {
      const err = isLive ? await liveAcct.open(side, margin, leverage) : await account.open(side, margin, leverage, quote);
      if (!err) setLastFill(null);
      return err;
    });
  };
  const close = () =>
    run("close", async () => {
      const { result, error: err } = isLive ? await liveAcct.close() : await account.close(quote);
      if (result) setLastFill(result);
      return err;
    });
  const reset = () =>
    run("reset", async () => {
      const err = await account.reset();
      if (!err) setLastFill(null);
      return err;
    });
  const setFraction = (f: number) => {
    const max = affordable ?? 0;
    typeAmount(String(f === 1 ? max : Math.floor(max * f * 100) / 100));
  };

  // Default the amount to 10% of what's available once the balance is known
  // (and again after signing in/out or switching venue), unless the user typed one.
  useEffect(() => {
    if (available === null || touched.current) return;
    const tenth = Math.floor((affordable ?? 0) * 0.1);
    setAmount(tenth >= 1 ? String(tenth) : "");
  }, [available === null, account.mode, venue]);

section.sim(data-side={position?.side ?? side} data-mode={isLive ? "live" : account.mode})
  header.sim-head
    h2 #{isLive ? "Trade on OKX" : "Simulate a position"}
    if canLive
      .sim-venue(role="radiogroup" aria-label="Trading venue")
        button(type="button" role="radio" aria-checked={!isLive} className={cn("sim-venue-opt", !isLive && "is-active")} disabled={busy !== null || inFlight} onClick={() => setVenue("paper")}) Paper
        button(type="button" role="radio" aria-checked={isLive} className={cn("sim-venue-opt is-live", isLive && "is-active")} disabled={busy !== null} onClick={() => setVenue("live")}) Live
    elseif !isLive
      span.sim-balance
        span.sim-mode-dot
        button.sim-link(type="button" disabled={busy !== null} onClick={reset} title="Restore the $10,000 paper balance") Reset balance
  p(className={cn("sim-mode", (account.mode === "cloud" || isLive) && "is-cloud", isLive && "is-live")})
    if isLive
      | #{liveCfg?.mode === "demo" ? "OKX demo trading · simulated funds on OKX · your USD balance" : "LIVE on OKX · real funds · your USD balance"}
    // else
    //   | #{account.mode === "cloud" ? "Saved to your account · priced by the server" : account.loading ? "Checking your account…" : "Practice mode · sign in to save positions"}
  if canLive && !isLive && account.mode === "cloud"
    button.sim-link.sim-reset-inline(type="button" disabled={busy !== null} onClick={reset} title="Restore the $10,000 paper balance") Reset paper balance

  if loading
    .sim-loading Loading your account…
  elseif inFlight && !position
    .sim-loading Placing your order on OKX…
  elseif position && live
    .sim-open
      .sim-open-top
        span(className={cn("sim-badge", position.side === "up" ? "is-up" : "is-down")}) #{position.side === "up" ? "▲ Up" : "▼ Down"} #{position.leverage}×
        span.sim-muted #{fmtSize(position.size)} #{base} · #{usd(position.margin)} margin
      .sim-pnl
        strong(className={live.pnl >= 0 ? "is-up" : "is-down"}) #{usd(live.pnl, true)}
        span(className={live.roe >= 0 ? "is-up" : "is-down"}) #{fmtPct(live.roe)} ROE
      dl.sim-rows(className='flex-1! h-full flex flex-col')
        .sim-row
          dt Entry
          dd #{fmtPrice(position.entry, tickSz)}
        .sim-row
          dt Mark
          dd #{fmtPrice(mark, tickSz)}
        .sim-row
          dt Liq. price (est.)
          dd.is-down #{fmtPrice(live.liq, tickSz)}
        .sim-row
          dt Notional
          dd #{usd(live.notional)}
      .sim-risk(className='' title="Distance from liquidation")
        .sim-risk-bar(style={{ width: `${live.safety * 100}%` }} data-danger={live.safety < 0.25 ? "1" : "0"})
      button.sim-submit.sim-close(type="button" disabled={busy !== null || inFlight} onClick={close})
        | #{busy === "close" || liveAcct.status === "closing" ? (isLive ? "Closing on OKX…" : "Closing…") : `Close position ${usd(live.pnl - position.openFee - position.size * (exitFor(position.side) ?? 0) * TAKER_FEE, true)}${isLive ? " (est.)" : ""}`}
  else
    .sim-form
      .sim-sides(role="radiogroup" aria-label="Direction")
        button(type="button" role="radio" aria-checked={side === "up"} className={cn("sim-side is-up", side === "up" && "is-active")} onClick={() => setSide("up")}) ▲ Up
        button(type="button" role="radio" aria-checked={side === "down"} className={cn("sim-side is-down", side === "down" && "is-active")} onClick={() => setSide("down")}) ▼ Down

      label.sim-field
        // span Amount (margin)
        .sim-input
          span(className='font-[450] text-xl') $
          input(
            ~ type="number"
            ~ inputMode="decimal"
            ~ min="0"
            ~ step="any"
            ~ value={amount}
            ~ placeholder="0.00"
            ~ onInput={(e: Event) => typeAmount((e.target as HTMLInputElement).value)}
            ~ )
          span #{isLive ? "USD" : "Amount"}
      // button.sim-available(type="button" disabled={!affordable} onClick={() => setFraction(1)} title="Use the maximum at this multiplier")
      //   span Available #{usd(available)}
      //   span Max #{usd(affordable)} at #{leverage}×
      .sim-chips
        each f in [0.1, 0.25, 0.5, 1] key f
          button.sim-chip(type="button" onClick={() => setFraction(f)}) #{f === 1 ? "Max" : `${f * 100}%`}

      label.sim-field
        span.sim-field-head
          | Multiplier
          strong #{leverage}×
        input.sim-range(
          ~ type="range"
          ~ min="1"
          ~ max={effMaxLeverage}
          ~ step="1"
          ~ value={leverage}
          ~ style={{ "--fill": `${effMaxLeverage > 1 ? ((leverage - 1) / (effMaxLeverage - 1)) * 100 : 100}%` }}
          ~ onInput={(e: Event) => setLeverage(Number((e.target as HTMLInputElement).value))}
          ~ )
      .sim-chips
        each x in leverageStops(effMaxLeverage) key x
          button(type="button" className={cn("sim-chip", leverage === x && "is-active")} onClick={() => setLeverage(x)}) #{x}×

      dl.sim-rows
        .sim-row
          dt Position size
          dd #{preview ? `${fmtSize(preview.size)} ${base}` : "—"}
        .sim-row
          dt Entry (est.)
          dd #{fmtPrice(entryEst, tickSz)}
        .sim-row
          dt Liq. price (est.)
          dd #{preview ? fmtPrice(liquidationPrice(preview), tickSz) : "—"}
        .sim-row
          dt Fee (#{(TAKER_FEE * 100).toFixed(2)}%)
          dd #{preview ? usd(preview.openFee) : "—"}

      if overBalance
        p.sim-error #{isLive && available !== null && maxMargin(available, leverage) > orderCap ? `Max order is $${liveCfg?.maxOrderUsd} notional — max ${usd(affordable)} at ${leverage}×.` : `Exceeds your available balance — max ${usd(affordable)} at ${leverage}× (amount + ${(TAKER_FEE * 100).toFixed(2)}% fee on the position).`}
      if confirming && preview
        .sim-confirm(role="alertdialog" aria-label="Confirm real order")
          strong #{liveCfg?.mode === "demo" ? "Place a demo order on OKX?" : "Place a REAL order on OKX?"}
          p Market #{side === "up" ? "buy (Up)" : "sell (Down)"} of ~#{fmtSize(preview.size)} #{base} at ~#{fmtPrice(entryEst, tickSz)}, #{leverage}×, using #{usd(margin)} of your USD balance. Size is rounded down to whole contracts; the price, size and fee you get are OKX's actual fill.
          .sim-confirm-actions
            button.sim-chip(type="button" onClick={() => setConfirming(false)}) Cancel
            button(type="button" className={cn("sim-submit", side === "up" ? "is-up" : "is-down")} disabled={busy !== null} onClick={submit}) Confirm order
      else
        button(type="button" className={cn("sim-submit", side === "up" ? "is-up" : "is-down")} disabled={!preview || overBalance || busy !== null || inFlight} onClick={submit})
          | #{busy === "open" ? (isLive ? "Placing on OKX…" : "Placing…") : `${side === "up" ? "Go Up" : "Go Down"} ${leverage}× · ${preview ? usd(margin) : ""}${isLive ? (liveCfg?.mode === "demo" ? " · demo" : " · LIVE") : ""}`}

  if error
    p.sim-error #{error}
  if account.closedRemotely
    p.sim-result.is-down Your #{base} position was liquidated by the server.
  elseif lastFill
    p(className={cn("sim-result", lastFill.realized >= 0 ? "is-up" : "is-down")})
      | #{lastFill.liquidated ? "Liquidated" : "Closed"} #{lastFill.side === "up" ? "Up" : "Down"} #{lastFill.leverage}× at #{fmtPrice(lastFill.exit, tickSz)} · #{usd(lastFill.realized, true)} (#{fmtPct((lastFill.realized / lastFill.margin) * 100)})

  if isLive
    p.sim-note Market orders on OKX #{liveCfg?.mode === "demo" ? "demo trading" : "(real funds)"} · fills, fees and size from OKX · max $#{liveCfg?.maxOrderUsd} per order · liquidated at #{(MAINT_MARGIN * 100).toFixed(1)}% maintenance margin.
  // else
  //   p.sim-note Live OKX prices · fills cross the spread · #{(MAINT_MARGIN * 100).toFixed(1)}% maintenance margin · no real funds.
