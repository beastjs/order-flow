import { useEffect, useState } from "octane";
import { Link } from "@octanejs/tanstack-router";
import { AssetGlyph } from "./AssetIndex.btsx";
import PositionExitModal from "./PositionExitModal.btsx";
import { useOkxMarkPrices, useOkxTickers } from "@/hooks/useOkx";
import { useOpenPositions, type OpenPositionRow, type SimResult } from "@/hooks/usePaperAccount";
import { convexErrorMessage } from "@/hooks/useConvex";
import { estimateClosePnl, liquidationPrice, unrealizedPnl } from "@/lib/paper/math";
import { fmtExitPrice, fmtPct, fmtPrice, fmtSize } from "./assetFormat";
import { cn } from "@/lib/utils";
import {Icon} from "../../lib/icons";

module
  const CLOSE_ALL_CONFIRM_MS = 5_000;

  // Round first so a value like −0.001 prints "$0.00", not "−$0.00".
  const usd = (v: number | null | undefined, signed = false) => {
    if (v === null || v === undefined || !Number.isFinite(v)) return "—"
    const cents = Math.round(v * 100) / 100
    return `${signed && cents > 0 ? "+" : cents < 0 ? "−" : ""}$${Math.abs(cents).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
  }

component ExitTargetChip
  props { row, kind, value, disabled, onEdit }: { row: OpenPositionRow; kind: "stop-loss" | "take-profit"; value: number; disabled: boolean; onEdit: () => void }
  setup
    const stop = kind === "stop-loss";
    const amount = usd(value, true);
    const price = fmtExitPrice(row.position, value);
  button.pos-exit-chip(
    ~ type="button"
    ~ data-kind={kind}
    ~ aria-label={`Edit ${row.base} ${stop ? "stop loss" : "take profit"}, ${amount} net PnL at ${price}`}
    ~ aria-haspopup="dialog"
    ~ disabled={disabled}
    ~ onClick={onEdit}
    ~ )
    span #{stop ? "SL" : "TP"}
    span #{amount}
    span.pos-exit-chip-price · #{price}

component PositionRow
  props { row, mark, exit, pnl, busy, disabled, onClose, onExitTargets }: { row: OpenPositionRow; mark?: number; exit?: number; pnl: number | null; busy: boolean; disabled: boolean; onClose: (row: OpenPositionRow) => void; onExitTargets: (row: OpenPositionRow) => void }
  setup
    const p = row.position;
    const canClose = pnl !== null && Boolean(exit);
    const pnlClass = pnl === null ? "" : pnl >= 0 ? "is-up" : "is-down";
    const stopLoss = p.exitTargets?.stopLoss ?? null;
    const takeProfit = p.exitTargets?.takeProfit ?? null;
    const hasExitTargets = stopLoss !== null || takeProfit !== null;
    const editExitTargets = () => onExitTargets(row);
  article.pos-article(className='portrait:flex-col!' data-side={p.side})
    div.pos-row
      Link.pos-asset(to="/perps/$assetId" params={{ assetId: row.base }})
        AssetGlyph(base={row.base} size={38})
        span.pos-asset-name
          strong #{row.base}
          span.pos-side(className={cn(p.side === "up" ? "is-up" : "is-down")}) #{p.side === "up" ? "↑ Up" : "↓ Down"} #{p.leverage}X
      .pos-cell(className='portrait:hidden!')
        span.pos-label Size
        span #{fmtSize(p.size)}
      .pos-cell(className='portrait:hidden!')
        span.pos-label Entry
        span #{fmtPrice(p.entry)}
      .pos-cell(className='portrait:hidden!')
        span.pos-label Mark
        span #{fmtPrice(mark)}
      .pos-cell(className='portrait:hidden!')
        span.pos-label Liquidation (est)
        span.is-down #{mark ? fmtPrice(liquidationPrice(p)) : "—"}
      .pos-cell(className='portrait:hidden!')
        span.pos-label Margin
        span #{usd(p.margin)}
      .pos-cell.pos-pnl(className='portrait:items-end!')
        span.pos-label(className='portrait:hidden!') PnL
        span.pos-pnl-val(className={cn('portrait:text-right portrait:font-[600]', pnlClass)})
          span(className='portrait:block!') #{usd(pnl, true)}
          small(className={pnlClass}) #{pnl === null ? "" : fmtPct((pnl / p.margin) * 100)}
    .pos-row-actions
      if hasExitTargets
        .pos-exit-chips
          if stopLoss !== null
            ExitTargetChip(row={row} kind="stop-loss" value={stopLoss} disabled={disabled} onEdit={editExitTargets})
          if takeProfit !== null
            ExitTargetChip(row={row} kind="take-profit" value={takeProfit} disabled={disabled} onEdit={editExitTargets})
      else
        button(
          ~ type="button"
          ~ className="mx-3! hover:brightness-135 transition-all duration-200 ease-out active:scale-97"
          ~ aria-label={`Set ${row.base} stop loss and take profit`}
          ~ aria-haspopup="dialog"
          ~ disabled={disabled}
          ~ onClick={editExitTargets}
          ~ )
          img(src="/pnl.svg" className="h-12 w-10" alt="")
      button.pos-close(className='portrait:bg-(--bg-hover)! portrait:w-full portrait:h-[50px]! portrait:rounded-none! portrait:hover:brightness-125! sm:rounded-xl! md:size-14! sm:px-0! flex! flex-row! justify-center! items-center! border-none! portrait:transition-colors! duration-280! ease-out! sm:mr-4!' type="button" aria-label={busy ? "Closing" : "Close"} disabled={disabled || !canClose} onClick={() => onClose(row)} title={canClose ? `Close at market · ${usd(pnl, true)} after fees` : "Waiting for a price"})
        Icon(name={busy ? 'circle' : 'close'} className='size-6 portrait:hidden!')
        span(className='md:hidden portrait:text-lg! font-[450]!') #{busy ? "Closing…" : "Close"}

setup
  const open = useOpenPositions();
  const instIds = open.rows.map((r) => r.instId);
  const tickers = useOkxTickers(instIds, 500);
  const marks = useOkxMarkPrices(instIds, 500);
  const [closing, setClosing, getClosing] = useState<string | null>(null);
  const [confirmMode, setConfirmMode, getConfirmMode] = useState<typeof open.mode | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [lastFill, setLastFill] = useState<(SimResult & { base: string }) | null>(null);
  const [bulkResult, setBulkResult] = useState<Awaited<ReturnType<typeof open.closeAll>> | null>(null);
  const [target, setTarget] = useState<{ key: string; openedAt: number; mode: typeof open.mode } | null>(null);
  const targetRow = target?.mode === open.mode && !open.loading
    ? open.rows.find((row) => row.key === target.key && row.position.openedAt === target.openedAt)
    : undefined;
  const confirming = confirmMode === open.mode && !open.loading && open.rows.length > 0;

  useEffect(() => {
    if (!confirming) return;
    const timer = setTimeout(() => setConfirmMode(null), CLOSE_ALL_CONFIRM_MS);
    return () => clearTimeout(timer);
  }, [confirming]);

  const pricedRows = open.rows.map((row) => {
    const ticker = tickers[row.instId];
    const mark = marks[row.instId] ?? ticker?.last;
    const exit = (row.position.side === "up" ? ticker?.bidPx : ticker?.askPx) || ticker?.last;
    const pnl = mark ? estimateClosePnl(row.position, unrealizedPnl(row.position, mark), exit) : null;
    return { row, mark, exit, pnl };
  });

  let totalMargin = 0;
  let totalPnl: number | null = null;
  for (const { row, pnl } of pricedRows) {
    totalMargin += row.position.margin;
    if (pnl !== null) totalPnl = (totalPnl ?? 0) + pnl;
  }

  const getQuote = (instId: string) => {
    const t = tickers[instId];
    return { bid: t?.bidPx || t?.last, ask: t?.askPx || t?.last };
  };

  const close = async (row: OpenPositionRow) => {
    if (getClosing() !== null) return;
    setClosing(row.key);
    setError(null);
    setLastFill(null);
    setBulkResult(null);
    try {
      const { result, error: err } = await open.close(row, getQuote(row.instId));
      setError(err);
      if (result) setLastFill({ ...result, base: row.base });
    } finally {
      setClosing(null);
    }
  };

  const closeAll = async () => {
    if (getClosing() !== null || open.loading || open.rows.length === 0) return;
    if (getConfirmMode() !== open.mode) {
      setConfirmMode(open.mode);
      return;
    }
    setClosing("all");
    setConfirmMode(null);
    setError(null);
    setLastFill(null);
    setBulkResult(null);
    try {
      setBulkResult(await open.closeAll(getQuote));
    } catch (err) {
      setError(convexErrorMessage(err));
    } finally {
      setClosing(null);
    }
  };

section.pos
  .pos-overview
    .pos-summary(className='portait:py-2!')
      .pos-stat
        span Open positions
        strong #{open.loading ? "—" : open.rows.length}
      .pos-stat
        span Margin in use
        strong #{usd(totalMargin)}
      .pos-stat
        span Unrealized PnL
        strong(className={totalPnl === null ? "" : totalPnl >= 0 ? "is-up" : "is-down"}) #{usd(totalPnl, true)}
      .pos-stat
        span Available balance
        strong #{usd(open.balance)}
    div(className='border-b border-(--border) py-5!')
      if (!open.loading && open.rows.length > 0) || closing === "all"
        button.pos-close.pos-close-all(
          ~ className={cn("portrait:h-14! portrait:w-full h-16! w-64", confirming && "is-confirming")}
          ~ type="button"
          ~ disabled={closing !== null}
          ~ onClick={closeAll}
          ~ onBlur={() => setConfirmMode(null)}
          ~ onKeyDown={(event: KeyboardEvent) => {
            ~ if (event.key === "Escape") setConfirmMode(null);
            ~ if (event.repeat && (event.key === "Enter" || event.key === " ")) event.preventDefault();
          ~ }}
          ~ )
          | #{closing === "all" ? "Closing positions…" : confirming ? "Confirm close all" : "Close all Positions"}

  if error
    p.sim-error(role="alert") #{error}
  if closing === "all"
    p.sim-mode(role="status") Closing open positions at market…
  if bulkResult
    .pos-bulk-result(role="status")
      if bulkResult.closed > 0
        p(className={cn("sim-result", bulkResult.realized >= 0 ? "is-up" : "is-down")})
          | Closed #{bulkResult.closed} #{bulkResult.closed === 1 ? "position" : "positions"} · #{usd(bulkResult.realized, true)} realized PnL
      elseif bulkResult.failures.length === 0
        p.sim-mode No positions were open.
      if bulkResult.failures.length > 0
        .pos-bulk-errors
          strong Could not close #{bulkResult.failures.length} #{bulkResult.failures.length === 1 ? "position" : "positions"}
          ul
            each failure in bulkResult.failures key failure.instId
              li #{failure.instId} · #{failure.message}
  if lastFill
    p(className={cn("sim-result", lastFill.realized >= 0 ? "is-up" : "is-down")})
      | Closed #{lastFill.side === "up" ? "Up" : "Down"} #{lastFill.leverage}× #{lastFill.base} at #{fmtPrice(lastFill.exit)} · #{usd(lastFill.realized, true)} (#{fmtPct((lastFill.realized / lastFill.margin) * 100)})

  if open.loading
    p.lp-grid-empty Loading positions…
  else
    .pos-list
      each item in pricedRows key item.row.key
        PositionRow(
          ~ row={item.row}
          ~ mark={item.mark}
          ~ exit={item.exit}
          ~ pnl={item.pnl}
          ~ busy={closing === item.row.key}
          ~ disabled={closing !== null || confirming}
          ~ onClose={close}
          ~ onExitTargets={(row: OpenPositionRow) => setTarget({ key: row.key, openedAt: row.position.openedAt, mode: open.mode })}
          ~ )
      empty
        .pos-empty
          p No open positions.
          Link.lp-btn.lp-btn-ghost(to="/perps") Browse markets

  if targetRow
    PositionExitModal(row={targetRow} mode={open.mode} onSave={(targets) => open.setExitTargets(targetRow, targets)} onClose={() => setTarget(null)})
