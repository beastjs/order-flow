import { useMemo, useState } from "octane";
import { fmtPct, fmtPrice, sparkLinePath, sparkPaths } from "./assetFormat";
import { useLivePriceChart } from "./priceChartMotion";

module
  const W = 100
  const H = 320

  function fmtTime(ts: number, spanMs: number): string {
    const d = new Date(ts)
    if (spanMs <= 2 * 3_600_000) return d.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", second: "2-digit" })
    if (spanMs <= 2 * 86_400_000) return d.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit" })
    return d.toLocaleString("en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })
  }

props { candles, tickSz, loading, live = false }: { candles: { ts: number; close: number }[]; tickSz?: number; loading?: boolean; live?: boolean }
setup
  const [hover, setHover] = useState<number | null>(null);
  const { samples, paths, target } = useMemo(() => {
    const samples = candles.filter(({ close }) => Number.isFinite(close));
    const paths = sparkPaths(samples.map(({ close }) => close), W, H, 12);
    const target = paths && {
      timestamps: samples.map(({ ts }) => ts),
      points: paths.points,
      baselineY: paths.points[0][1],
      // The linear price scale maps the mean close to the mean plotted height.
      averageY: paths.points.reduce((sum, [, y]) => sum + y, 0) / paths.points.length,
    };
    return { samples, paths, target };
  }, [candles]);
  const frame = useLivePriceChart(target, live && !loading);
  const drawing = useMemo(() => {
    if (!frame || !paths) return null;
    if (!live && frame === target) return paths;
    const line = sparkLinePath(frame.points, 4);
    return { line, area: `${line} L${W},${H} L${frame.points[0][0]},${H} Z` };
  }, [frame, live, paths, target]);
  const first = samples[0]?.close;
  const lastClose = samples[samples.length - 1]?.close;
  const up = lastClose >= first;
  const span = samples.length > 1 ? samples[samples.length - 1].ts - samples[0].ts : 0;
  const idx = hover === null || !paths ? null : Math.min(samples.length - 1, Math.max(0, hover));
  const hovered = idx === null ? null : samples[idx];
  const point = hovered && frame && frame.points[frame.timestamps.indexOf(hovered.ts)];
  const onMove = (e: PointerEvent) => {
    const box = (e.currentTarget as Element).getBoundingClientRect();
    const frac = (e.clientX - box.left) / box.width;
    setHover(Math.round(frac * (samples.length - 1)));
  };

.price-chart(data-up={up ? "1" : "0"})
  if hovered
    .price-chart-readout
      strong #{fmtPrice(hovered.close, tickSz)}
      span(className={hovered.close >= first ? "is-up" : "is-down"}) #{fmtPct(((hovered.close - first) / first) * 100)}
      span.price-chart-time #{fmtTime(hovered.ts, span)}

      .price-chart-axis
        span H #{fmtPrice(paths?.hi, tickSz)}
        span L #{fmtPrice(paths?.lo, tickSz)}
  if frame && drawing
    .price-chart-plot
      svg.price-chart-svg(
        ~ viewBox={`0 0 ${W} ${H}`}
        ~ preserveAspectRatio="none"
        ~ onPointerMove={onMove}
        ~ onPointerLeave={() => setHover(null)}
        ~ role="img"
        ~ aria-label="Price chart"
        ~ )
        defs
          linearGradient#price-chart-fill(x1="0" x2="0" y1="0" y2="1")
            stop(offset="0%" stop-color="currentColor" stop-opacity="0.18")
            stop(offset="100%" stop-color="currentColor" stop-opacity="0")
        line.price-chart-base(
          ~ x1="0"
          ~ x2={W}
          ~ y1={frame.baselineY}
          ~ y2={frame.baselineY}
          ~ vector-effect="non-scaling-stroke"
          ~ )
        path(d={drawing.area} fill="url(#price-chart-fill)")
        line.price-chart-average(x1="0" x2={W} y1={frame.averageY} y2={frame.averageY} vector-effect="non-scaling-stroke")
        path(d={drawing.line} fill="none" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke")
        if point
          line.price-chart-cross(x1={point[0]} x2={point[0]} y1="0" y2={H} vector-effect="non-scaling-stroke")
  else
    .price-chart-empty #{loading ? "Loading chart…" : "No data for this range."}
