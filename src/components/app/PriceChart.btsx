import { useState } from "octane";
import { fmtPct, fmtPrice, sparkPaths } from "./assetFormat";

module
  const W = 1000
  const H = 320

  function fmtTime(ts: number, spanMs: number): string {
    const d = new Date(ts)
    if (spanMs <= 2 * 3_600_000) return d.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", second: "2-digit" })
    if (spanMs <= 2 * 86_400_000) return d.toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit" })
    return d.toLocaleString("en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })
  }

props { candles, tickSz, loading }: { candles: { ts: number; close: number }[]; tickSz?: number; loading?: boolean }
setup
  const [hover, setHover] = useState<number | null>(null);
  const closes = candles.map((c) => c.close);
  const paths = sparkPaths(closes, W, H, 12);
  const first = closes[0];
  const lastClose = closes[closes.length - 1];
  const up = lastClose >= first;
  const span = candles.length > 1 ? candles[candles.length - 1].ts - candles[0].ts : 0;
  const idx = hover === null || !paths ? null : Math.min(paths.points.length - 1, Math.max(0, hover));
  const point = idx === null || !paths ? null : paths.points[idx];
  const hovered = idx === null ? null : candles[idx];
  const onMove = (e: PointerEvent) => {
    const box = (e.currentTarget as Element).getBoundingClientRect();
    const frac = (e.clientX - box.left) / box.width;
    setHover(Math.round(frac * (closes.length - 1)));
  };

.price-chart(data-up={up ? "1" : "0"})
  if hovered
    .price-chart-readout
      strong #{fmtPrice(hovered.close, tickSz)}
      span(className={hovered.close >= first ? "is-up" : "is-down"}) #{fmtPct(((hovered.close - first) / first) * 100)}
      span.price-chart-time #{fmtTime(hovered.ts, span)}
  if paths
    .price-chart-plot
      svg.price-chart-svg(
        ~ viewBox={`0 0 ${W} ${H}`}
        ~ preserveAspectRatio="none"
        ~ onPointerMove={onMove}
        ~ onPointerLeave={() => setHover(null)}
        ~ role="img"
        ~ aria-label="Price chart"
        ~ )
        defs
          linearGradient#price-chart-fill(x1="0" x2="0" y1="0" y2="1")
            stop(offset="0%" stop-color="currentColor" stop-opacity="0.18")
            stop(offset="100%" stop-color="currentColor" stop-opacity="0")
        line.price-chart-base(
          ~ x1="0"
          ~ x2={W}
          ~ y1={paths.points[0][1]}
          ~ y2={paths.points[0][1]}
          ~ vector-effect="non-scaling-stroke"
          ~ )
        path(d={paths.area} fill="url(#price-chart-fill)")
        path(d={paths.line} fill="none" stroke="currentColor" stroke-width="1.6" vector-effect="non-scaling-stroke")
        if point
          line.price-chart-cross(x1={point[0]} x2={point[0]} y1="0" y2={H} vector-effect="non-scaling-stroke")
      .price-chart-axis
        span H #{fmtPrice(paths.hi, tickSz)}
        span L #{fmtPrice(paths.lo, tickSz)}
  else
    .price-chart-empty #{loading ? "Loading chart…" : "No data for this range."}
