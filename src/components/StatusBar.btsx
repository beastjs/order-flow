
module "use client";
import { useSessionStore, useThrottledSessionStore } from "@/lib/session/sessionContext";
import { formatDuration, VENUE_LABEL } from "@/lib/format";
import { useNow } from "@/hooks/useNow";
module
  // ─── Status bar ──────────────────────────────────────────────────
  // Feed health per venue, data lag, session age and a UTC clock.
  // ─── Status bar ──────────────────────────────────────────────────
  // Feed health per venue, data lag, session age and a UTC clock.

setup
  const connections = useSessionStore((s) => s.connections);
  const selectedVenues = useSessionStore((s) => s.selectedVenues);
  const marketType = useSessionStore((s) => s.marketType);
  // Only the fields shown are selected, so prints don't re-render the bar.
  const lag = useThrottledSessionStore((s) => s.session?.lastTradeLagMs ?? null, 500);
  const sessionStart = useSessionStore((s) => s.session?.startTime ?? null);
  const candles = useSessionStore((s) => s.candles.length);
  const now = useNow();
  const replay = useSessionStore((s) => s.replay);
  const venues = marketType === "forex" ? (["finnhub-forex"] as const) : selectedVenues;
  const live = venues.filter((v) => connections[v]?.status === "live").length;
  const lagTone = lag === null ? "" : lag < 250 ? "tone-buy" : lag < 1000 ? "tone-warn" : "tone-sell";
footer.statusbar
  .statusbar-feeds
    if replay
      span.feed(title="The live feed is disconnected while a recording plays back")
        span(className="status-dot stale")
        | Replaying recorded data · live feed paused
    | #{!replay && venues.map((venue) => {
      ~ const conn = connections[venue];
      ~ const status = conn?.status ?? "connecting";
      ~ return (<span key={venue} className="feed" title={`${VENUE_LABEL[venue] ?? venue}: ${status}${conn?.error ? ` — ${conn.error}` : ""}${conn?.reconnectAttempts ? ` · ${conn.reconnectAttempts} reconnects` : ""}`}>
      ~ <span className={`status-dot ${status}`}/>
      ~ {VENUE_LABEL[venue] ?? venue}
      ~ <em>{conn?.stateFlag ?? status}</em>
      ~ </span>);
      ~ })
      ~ }
    if !replay && venues.length > 1
      strong #{live}/#{venues.length} live
  .statusbar-meta
    span(title="Exchange timestamp to local receive time for the latest print (includes clock skew)")
      span(className='statusbar-meta-label') Feed lag
      b(className={lagTone})
        if lag === null
          | #{"—"}
        else
          | #{`${lag.toFixed(0)} ms`}
    span
      | Session
      b
        if sessionStart !== null && now
          | #{formatDuration(now - sessionStart)}
        else
          | #{"—"}
    span
      | Candles
      b #{candles + (sessionStart !== null ? 1 : 0)}
    span.statusbar-clock
      if now
        | #{new Date(now).toISOString().slice(11, 19)}
      else
        | #{"--:--:--"}
      |
      small UTC
