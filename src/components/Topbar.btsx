
module "use client";
import { useMarketUrlState } from "@/hooks/useMarketUrlState";
import type { PanelVisibility, TimeValue, ToolProfile, Venue, VenueSelection } from "@/lib/types/market";
import { FOREX_SYMBOLS } from "@/lib/config/venues";
import { THEME_OPTIONS, type Theme } from "@/lib/theme";
import { venueSupports } from "@/lib/adapters/capabilities";
import { CRYPTO_ASSETS } from "@/lib/config/instruments";
import AssetLogo, {VenueLogo} from "@/components/AssetLogo.btsx";
import Picker, {type PickerOption} from "@/components/ui/Picker.btsx";
import { useUIStore } from "@/lib/store/uiStore";
import { REPO_URL, Wordmark } from "@/components/Logo.btsx";
import { Icon, IconName } from "@/lib/icons";
import { createElement, useMemo } from "octane";
import Segmented from "./ui/Segmented.btsx";
import Menu, { MenuCheckbox, MenuSection } from "@/components/ui/Menu.btsx";
import { Select } from "@/components/ui/Primitives.btsx";
import AlertsMenu from "./AlertsMenu.btsx";
import ExportMenu from "./ExportMenu.btsx";
import RecordingsMenu from "./RecordingsMenu.btsx";
module
  const TIMEFRAMES: {
    value: TimeValue;
    label: string;
    hint?: string
  }[] = [
    { value: "1m", label: "1m", hint: "1 minute candle interval" }, { value: "5m", label: "5m" }, { value: "15m", label: "15m" },
    { value: "30m", label: "30m" }, { value: "1h", label: "1H" }, { value: "4h", label: "4H" },
  ];
  const PROFILES: {
    value: ToolProfile;
    label: string;
    title: string;
  }[] = [
    { value: "order-flow", label: "Order Flow", title: "Footprint, tape, CVD and volume z-score" },
    { value: "liquidity", label: "Liquidity", title: "Order book, depth, imbalance and traded-volume heatmap" },
    { value: "volatility", label: "Volatility", title: "Realized volatility, volume z-score and tape" },
  ];
  const VENUES: Record<"perpetual" | "spot", {
    value: Venue;
    label: string;
    icon: IconName
  }[]> = {
    perpetual: [
      { value: "binance-futures", label: "Binance", icon: 'binance' }, { value: "bybit-futures", label: "Bybit", icon: 'bybit' },
      { value: "okx-futures", label: "OKX", icon: 'okx' }, { value: "hyperliquid", label: "Hyperliquid", icon: 'hyperliquid' },
      { value: "bitget-futures", label: "Bitget", icon: 'bitget' }, { value: "deribit", label: "Deribit", icon: 'deribit' },
    ],
    spot: [
      { value: "binance-spot", label: "Binance", icon: 'binance' }, { value: "coinbase-spot", label: "Coinbase", icon: 'coinbase' },
      { value: "okx-spot", label: "OKX", icon: 'okx' }, { value: "bybit-spot", label: "Bybit", icon: 'bybit' }, { value: "bitget-spot", label: "Bitget", icon: 'bitget' },
    ],
  };
  const PANEL_ITEMS: {
    key: keyof PanelVisibility;
    label: string;
    hint: string;
    group: "Chart" | "Studies" | "Sidebar";
  }[] = [
    { key: "volumeProfile", label: "Session profile", hint: "Volume by price beside the footprint", group: "Chart" },
    { key: "heatmap", label: "Traded-volume heatmap", hint: "Executed volume by price", group: "Chart" },
    { key: "cvd", label: "Cumulative delta", hint: "CVD with price overlay", group: "Studies" },
    { key: "volumeZ", label: "Volume z-score", hint: "Unusual participation", group: "Studies" },
    { key: "openInterest", label: "Open interest", hint: "OI with price and regime (perps)", group: "Studies" },
    { key: "liquidations", label: "Liquidations", hint: "Forced longs / shorts per bucket (perps)", group: "Studies" },
    { key: "venues", label: "Venues", hint: "Price, flow and lead / lag by venue", group: "Studies" },
    { key: "volatility", label: "Realized volatility", hint: "RV, ATR, Parkinson", group: "Studies" },
    { key: "depthOfMarket", label: "Market depth", hint: "Cumulative liquidity curve", group: "Studies" },
    { key: "orderBook", label: "Order book", hint: "Price ladder", group: "Sidebar" },
    { key: "obi", label: "Book imbalance", hint: "OBI gauge and history", group: "Sidebar" },
    { key: "timeSales", label: "Time & sales", hint: "Executed prints", group: "Sidebar" },
  ];
// lifted from the label attribute
component Label
  fragment
    Icon(name='panel')
    span.hide-compact Panels

setup
  const {
    marketType, symbol, venue, timeframe, toolProfile, replaying,
    chooseMarketType, chooseSymbol, chooseVenue, chooseTimeframe, chooseToolProfile,
  } = useMarketUrlState();
  const theme = useUIStore((s) => s.theme);
  const setTheme = useUIStore((s) => s.setTheme);
  const panels = useUIStore((s) => s.panels);
  const setPanelVisible = useUIStore((s) => s.setPanelVisible);

  const isForex = marketType === "forex";

  const instrumentOptions = useMemo(() => isForex
    ? FOREX_SYMBOLS.map((pair) => ({ value: pair, label: pair, sub: "Spot FX", icon: 'all' }))
    : CRYPTO_ASSETS.map((asset) => {
      const value = `${asset.base}USDT`;
      return {
        value,
        label: value,
        sub: asset.name,
        keywords: asset.base,
        icon: asset.icon,
      };
    }), [isForex]);

  const venueOptions = marketType === "perpetual" || marketType === "spot" ? VENUES[marketType] : [];
  const aggregateValue: VenueSelection =  "all" ;
  const listedCount = venueOptions.filter((v) => venueSupports(v.value, symbol, marketType)).length;

  const venuePickerOptions = useMemo((): PickerOption<VenueSelection>[] => [
    {
      value: aggregateValue,
      label: marketType === "perpetual" ? "All perps" : "All spot",
      sub: `Aggregated · ${listedCount} venues`,
      icon: aggregateValue,
    },
    ...venueOptions.map((v) => ({
      value: v.value as VenueSelection,
      label: v.label,
      sub: venueSupports(v.value, symbol, marketType) ? (marketType === "perpetual" ? "Perpetual" : "Spot") : `No ${symbol} market`,
      disabled: !venueSupports(v.value, symbol, marketType),
      icon: v.icon,
    })),
  ], [marketType, symbol]);
header.topbar
  a(className="brand" href="/" aria-label="hyperflow home")
    Wordmark(size={28})
  fieldset.topbar-market(
    ~ disabled={replaying}
    ~ title={replaying ? "Exit the replay to change the market" : undefined}
    ~ )
    .topbar-group
      Segmented(
        ~ value={marketType}
        ~ onChange={chooseMarketType}
        ~ options={[
        ~ { value: "perpetual", label: "Perp", title: "Crypto perpetual futures" },
        ~ { value: "spot", label: "Spot", title: "Crypto spot" },
        ~ { value: "forex", label: "FX", title: "Foreign exchange" },
        ~ ]}
        ~ ariaLabel="Market"
        ~ )
    .topbar-group
      Picker(
        ~ searchable
        ~ className="instrument-picker"
        ~ value={symbol}
        ~ options={instrumentOptions}
        ~ onChange={chooseSymbol}
        ~ label="Instrument"
        ~ width={300}
        ~ )
      if !isForex
        Picker(
          ~ value={venue}
          ~ options={venuePickerOptions}
          ~ onChange={chooseVenue}
          ~ label="Venue"
          ~ width={260}
          ~ )
    .topbar-group
      Segmented(
        ~ accent
        ~ value={timeframe}
        ~ onChange={chooseTimeframe}
        ~ options={TIMEFRAMES}
        ~ ariaLabel="Candle interval"
        ~ )
  .topbar-spacer
  div(className="topbar-group topbar-tools")
    AlertsMenu
    RecordingsMenu
    ExportMenu
  .topbar-group
    Segmented(
      ~ value={toolProfile}
      ~ onChange={chooseToolProfile}
      ~ options={PROFILES}
      ~ ariaLabel="Workspace"
      ~ )
    Menu(hint="Panels" label={createElement(Label, {})})
      each group in (["Chart", "Studies", "Sidebar"] as const) key group
        MenuSection(title={group})
          each item in PANEL_ITEMS.filter((item) => item.group === group) key item.key
            MenuCheckbox(
              ~ checked={panels[item.key]}
              ~ onChange={(checked) => setPanelVisible(item.key, checked)}
              ~ label={item.label}
              ~ hint={item.hint}
              ~ )
    Select(
      ~ className="theme-select"
      ~ value={theme}
      ~ onChange={(e) => setTheme(e.currentTarget.value as Theme)}
      ~ aria-label="Theme"
      ~ )
      each option in THEME_OPTIONS key option.value
        option(value={option.value}) #{option.label}
  button(
    ~ className="ui-button connect-wallet-button is-primary"
    ~ aria-label="Connect wallet"
    ~ data-hint="Connect wallet"
    ~ )
    Icon(name='wallet' size={20})
    span.connect-label Connect
  span.topbar-break(aria-hidden)
