
module "use client";
import { useMarketSession, useSessionStore } from "@/lib/session/SessionContextProvider.btsx";
import { useNow } from "@/hooks/useNow";
import type { RecordingMeta } from "@/lib/recording/types";
import { formatCompact, formatDuration, VENUE_LABEL } from "@/lib/format";
import { Icon } from "@/lib/icons";
import { useCallback, useEffect, useState, createElement } from "octane";
import Menu, { MenuSection } from "@/components/ui/Menu.btsx";
module
  export function formatBytes(bytes: number): string {
    if (bytes >= 1e9)
      return `${(bytes / 1e9).toFixed(1)} GB`;
    if (bytes >= 1e6)
      return `${(bytes / 1e6).toFixed(1)} MB`;
    return `${Math.max(1, Math.round(bytes / 1e3))} KB`;
  }
  function formatStart(ms: number): string {
    const d = new Date(ms);
    const date = d.toLocaleDateString(undefined, { month: "short", day: "numeric" });
    const time = d.toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" });
    return `${date} ${time}`;
  }
// ─── Record / replay menu ────────────────────────────────────────
// Start or stop recording the live stream and pick a saved session to
// replay. Recordings live in this browser's IndexedDB.
// lifted from the label attribute
component Label
  fragment
    Icon(name='clock')
    span.hide-compact Replay
component RecordingList
  setup
    const session = useMarketSession();
    const recordingId = useSessionStore((s) => s.recording?.id);
    const replayId = useSessionStore((s) => s.replay?.meta.id);
    const [items, setItems] = useState<RecordingMeta[] | null>(null);
    const [error, setError] = useState<string | null>(null);

    const refresh = useCallback(async () => {
      const storage = session.storage;
      if (!storage)
        return setError("Recording isn't available in this browser.");
      try {
        setItems(await storage.listMeta());
      }
      catch (e) {
        setError(e instanceof Error ? e.message : String(e));
      }
    }, [session]);

    useEffect(() => {
      const id = setTimeout(() => void refresh(), 0);
      return () => clearTimeout(id);
    }, [refresh, recordingId]);

    const remove = async (meta: RecordingMeta) => {
      if (!window.confirm(`Delete the ${meta.symbol} recording from ${formatStart(meta.startedAt)}? This can't be undone.`))
        return;
      await session.storage?.delete(meta.id);
      void refresh();
    };
  .recordings-menu
    MenuSection(title="Saved sessions")
      if session.recordingNotice
        .menu-note #{session.recordingNotice}
      if error
        .menu-empty #{error}
      if !error && items === null
        .menu-empty Loading…
      if !error && items?.length === 0
        .menu-empty No recordings yet. Press Rec to capture the live stream; replay it here later at 1×, 5× or 20×.
      ul.recording-list
        each meta in items ?? [] key meta.id
          scope
            setup
              const live = meta.id === recordingId;
              const active = meta.id === replayId;
              const venues = meta.selectedVenues.length > 1 ? `${meta.selectedVenues.length} venues` : VENUE_LABEL[meta.selectedVenues[0]] ?? meta.selectedVenues[0];
            li(className={active ? "is-active" : ""})
              .recording-info
                strong
                  | #{meta.symbol}
                  |
                  span #{meta.marketType === "perpetual" ? "Perp" : meta.marketType === "spot" ? "Spot" : "FX"} · #{venues}
                small #{formatStart(meta.startedAt)} · #{formatDuration(meta.endedAt - meta.startedAt)} · #{formatCompact(meta.events, 1)} events · #{formatBytes(meta.bytes)}#{live ? " · recording" : !meta.complete ? " · interrupted" : ""}
              .recording-actions
                button(
                  ~ className="ui-button chip"
                  ~ type="button"
                  ~ disabled={live || meta.events === 0}
                  ~ onClick={() => void session.startReplay(meta)}
                  ~ data-hint="Replay this session"
                  ~ )
                  Icon(name='play')
                  span  Play
                button(
                  ~ className="ui-button chip icon-only"
                  ~ type="button"
                  ~ disabled={live || active}
                  ~ onClick={() => void remove(meta)}
                  ~ aria-label="Delete recording"
                  ~ data-hint="Delete recording"
                  ~ )
                  Icon(name='close')


setup
  const session = useMarketSession();
  const recording = useSessionStore((s) => s.recording);
  const replaying = useSessionStore((s) => s.replay !== null);
  const now = useNow(1000);

  // IndexedDB exists only in the browser; decide after mount so SSR markup matches.
  const [supported, setSupported] = useState(true);

  useEffect(() => {
    const id = setTimeout(() => setSupported(session.storage !== null), 0);
    return () => clearTimeout(id);
  }, [session]);
.record-controls
  button(
    ~ type="button"
    ~ className={`ui-button record-button ${recording ? "is-recording" : ""}`}
    ~ disabled={!supported || replaying}
    ~ onClick={() => (recording ? void session.stopRecording() : void session.startRecording())}
    ~ aria-label={recording ? "Stop recording" : "Record session"}
    ~ data-hint={!supported
    ~ ? "Recording isn't available in this browser" : recording
    ~ ? `Stop recording · ${formatCompact(recording.events, 1)} events · ${formatBytes(recording.bytes)}`
    ~ : "Record session"}
    ~ )
    Icon(name='delta')

    if recording
      span.record-elapsed
        if now
          | #{formatDuration(now - recording.startedAt)}
        else
          | #{"0s"}
    else
      span.hide-compact Rec
  Menu(hint="Replay recordings" label={createElement(Label, {})})
    RecordingList
