import { useEffect, useRef, useState } from "octane";
import Toast from "./ui/Toast.btsx";
import Icon from "@/lib/icons/Icon.btsx";
import { useConvexAuth, useConvexQuery } from "@/hooks/useConvex";
import { explorerTx } from "@/hooks/useTopUp";
import { depositChain } from "@/lib/deposits/config";
import { api } from "../../convex/_generated/api";
// ─── Funds-credited toasts ───────────────────────────────────────
// Watches the signed-in user's latest top-ups (a live Convex query) and
// toasts each one the moment the server credits it. Deposits that were
// already credited when the watch started stay quiet, so a page load
// never replays old toasts. One toast at a time; the rest queue.
module
  export { creditToastContent, type CreditNotice }

  interface CreditNotice {
    id: string
    amountUsd: number
    token: string
    chainId: number
    txHash: string
  }

  const usd = (v: number) => `$${v.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`

  /** Everything the credited toast shows — shared with the devtools preview so the two never drift. */
  function creditToastContent(n: CreditNotice) {
    return {
      title: `${usd(n.amountUsd)} credited!`,
      // Toasts are one line per field — keep this short enough not to truncate.
      description: `${n.token} top-up on ${depositChain(n.chainId)?.name ?? "chain"}`,
      icon: <Icon name="circle-check" className='size-6 text-(--text-primary)' />,
      actionLabel: "View txn",
      onAction: () => void window.open(explorerTx(n.chainId, n.txHash), "_blank", "noopener,noreferrer"),
      fuseColor: "#22c55e",
      // fuseColor: "#fafafa",
      duration: 6000,
      closeButton: false,
    }
  }

setup
  const authed = useConvexAuth().isAuthenticated;
  const deposits = useConvexQuery(api.deposits.listMine, authed ? { paginationOpts: { numItems: 10, cursor: null } } : "skip");
  // Ids already credited (or already toasted). null until the first result primes it.
  const seen = useRef<Set<string> | null>(null);
  const [queue, setQueue] = useState<CreditNotice[]>([]);

  // Signing out (or switching account) restarts the watch from scratch.
  useEffect(() => {
    seen.current = null;
    setQueue([]);
  }, [authed]);

  useEffect(() => {
    const page = deposits.data?.page;
    if (!page) return;
    const credited = page.filter((d) => d.status === "credited");
    if (seen.current === null) {
      seen.current = new Set(credited.map((d) => d._id));
      return;
    }
    const fresh = credited.filter((d) => !seen.current!.has(d._id));
    if (!fresh.length) return;
    fresh.forEach((d) => seen.current!.add(d._id));
    setQueue((q) => [
      ...q,
      ...fresh.reverse().map((d) => ({ id: d._id, amountUsd: d.amountUsd ?? 0, token: d.token ?? "", chainId: d.chainId, txHash: d.txHash })),
    ]);
  }, [deposits.data]);

  const current = queue[0];
  const content = current ? creditToastContent(current) : null;
  const next = () => setQueue((q) => q.slice(1));

if current && content
  Toast(
    ~ key={current.id}
    ~ open={true}
    ~ title={content.title}
    ~ description={content.description}
    ~ icon={content.icon}
    ~ actionLabel={content.actionLabel}
    ~ onAction={content.onAction}
    ~ onClose={next}
    ~ fuseColor={content.fuseColor}
    ~ duration={content.duration}
    ~ closeButton={content.closeButton}
    ~ )
