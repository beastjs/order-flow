module "use client";
import { MarketSession } from "./MarketSession";
import { SessionContext } from "./sessionContext";
import { loadInitialMarket } from "@/lib/url/marketParams";
import { useEffect, useState } from "octane";
import type { OctaneNode } from "octane";
module
  type ProviderProps = { children: OctaneNode }

props { children }: ProviderProps
setup
  // The linked market is in the store before the first feed subscription.
  const [session] = useState(() => new MarketSession(undefined, loadInitialMarket(location.search)));

  useEffect(() => {
    const onVisibilityChange = () => {
      // A hidden tab normally pauses the feed; recording, replay and browser
      // notifications need it to keep running.
      if (document.hidden) {
        if (!session.keepAliveWhenHidden())
          session.pause();
      }
      else
        session.resume();
    };
    document.addEventListener("visibilitychange", onVisibilityChange);
    return () => {
      document.removeEventListener("visibilitychange", onVisibilityChange);
      session.dispose();
    };
  }, [session]);
SessionContext(value={session}) #{children}
