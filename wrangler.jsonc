{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cfx",
	"main": "./src/worker.ts",
	// beastjs account (the login can reach more than one; pin it so deploys never guess).
	"account_id": "3e5e21a8e670deeba6401b80e003df01",
	"compatibility_date": "2026-11-18",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/asgard/users"],
		// Client-side routes (/perps, /perps/AAPL, /terminal) get index.html with 200.
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	}
}
